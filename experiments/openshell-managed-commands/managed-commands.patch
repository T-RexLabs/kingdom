+// These wrappers preserve the existing internal serde snapshot interface. The
+// network representation remains the typed protobuf message, never opaque JSON
+// or an encoded shell/stdout payload. Debug output excludes ownership/secrets.
+macro_rules! protocol_value {
+    ($name:ident, $message:ty) => {
+        #[derive(Clone, PartialEq)]
+        pub struct $name(pub $message);
+        impl Eq for $name {}
+        impl std::fmt::Debug for $name {
+            fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                formatter.write_str(concat!(stringify!($name), "(<redacted>)"))
+            }
+        }
+        impl serde::Serialize for $name {
+            fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+                serializer.serialize_bytes(&self.0.encode_to_vec())
+            }
+        }
+        impl<'de> serde::Deserialize<'de> for $name {
+            fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+                let bytes = <Vec<u8> as serde::Deserialize>::deserialize(deserializer)?;
+                if bytes.len() > MAX_CONTROL_BYTES {
+                    return Err(serde::de::Error::custom("managed control limit exceeded"));
+                }
+                <$message>::decode(bytes.as_slice())
+                    .map(Self)
+                    .map_err(serde::de::Error::custom)
+            }
+        }
+    };
+}
