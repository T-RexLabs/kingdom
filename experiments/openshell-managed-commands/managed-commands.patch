+#[test]
+fn managed_profile_requires_exact_driver_artifacts() {
+    use openshell_sandbox_backend::kingdom_managed_profile::ManagedProfile;
+    let profile = ManagedProfile {
+        schema_version: 1,
+        gateway_binary_sha256: "1".repeat(64),
+        supervisor_image: format!("registry.example/supervisor@sha256:{}", "2".repeat(64)),
+        sandbox_runtime_image: format!("registry.example/runtime@sha256:{}", "3".repeat(64)),
+        sandbox_runtime_binary_sha256: "4".repeat(64),
+    };
+    let mut config = DockerComputeConfig::default();
+    assert!(validate_managed_profile_config(&config).is_ok());
+    config.kingdom_managed_profile = Some(profile.clone());
+    assert!(validate_managed_profile_config(&config).is_err());
+    config.supervisor_image = Some(profile.supervisor_image.clone());
+    config.sandbox_runtime_image = Some(profile.sandbox_runtime_image.clone());
+    assert!(validate_managed_profile_config(&config).is_ok());
+    config.supervisor_bin = Some(PathBuf::from("/tmp/substitute"));
+    assert!(validate_managed_profile_config(&config).is_err());
+    config.supervisor_bin = None;
+    config.supervisor_image = Some("image:latest".into());
+    assert!(validate_managed_profile_config(&config).is_err());
+}
