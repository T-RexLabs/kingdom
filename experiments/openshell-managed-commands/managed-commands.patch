+// SPDX-License-Identifier: Apache-2.0
+//! Checked, relay-scoped managed operations. No raw SandboxProtocol forwarding.
+use super::{BoundaryClient, BoundaryLoopbackConnector};
+use crate::boundary_protocol::{Request, Response};
+use crate::kingdom_managed::{self as checked, ManagedRequest};
+use crate::kingdom_managed_profile::{ManagedProfile, PROFILE_CLAIM, PROFILE_DIGEST_CLAIM};
+use openshell_core::proto::kingdom_managed as p;
+use openshell_isolation_interface::contract::BackendError;
+use std::sync::Arc;
+
+#[derive(Clone)]
+pub struct BoundaryManagedClient {
+    client: Arc<BoundaryClient>,
+    authority: p::ManagedAuthority,
+    profile: Vec<u8>,
+}
+impl BoundaryLoopbackConnector {
+    /// Authority must come from the authenticated gateway relay context. Public
+    /// request fields do not establish a subject or workspace authorization.
+    pub fn managed(
+        &self,
+        authority: p::ManagedAuthority,
+    ) -> Result<BoundaryManagedClient, BackendError> {
+        let descriptor = &self.client.runtime_descriptor;
+        checked::validate_authority(
+            &authority,
+            &authority.gateway_id,
+            &descriptor.boundary_id,
+            &descriptor.generation,
+        )?;
+        let json = descriptor
+            .resource_claims
+            .get(PROFILE_CLAIM)
+            .ok_or_else(|| {
+                BackendError::Unsupported("managed deployment profile missing".into())
+            })?;
+        let pin = descriptor
+            .resource_claims
+            .get(PROFILE_DIGEST_CLAIM)
+            .ok_or_else(|| {
+                BackendError::Unsupported("managed deployment profile pin missing".into())
+            })?;
+        let profile = ManagedProfile::from_claims(json, pin).map_err(BackendError::Denied)?;
+        let digest = openshell_crypto::sha256(
+            profile
+                .canonical_json()
+                .map_err(BackendError::Denied)?
+                .as_bytes(),
+        )
+        .map_err(|error| BackendError::Unavailable(error.to_string()))?;
+        Ok(BoundaryManagedClient {
+            client: self.client.clone(),
+            authority,
+            profile: digest.to_vec(),
+        })
+    }
+}
+impl BoundaryManagedClient {
+    fn identity(&self, value: &p::CommandIdentity) -> Result<(), BackendError> {
+        let runtime = value
+            .runtime
+            .as_ref()
+            .ok_or_else(|| BackendError::Denied("managed runtime missing".into()))?;
+        checked::validate_runtime(runtime)?;
+        if value.schema_version != 1
+            || value.method != checked::START_METHOD
+            || value.gateway_id != self.authority.gateway_id
+            || value.workspace_id != self.authority.workspace_id
+            || value.subject_id != self.authority.subject_id
+            || runtime.sandbox_id != self.authority.sandbox_id
+            || runtime.boundary_generation != self.authority.boundary_generation
+            || runtime.deployment_profile_sha256 != self.profile
+        {
+            return Err(BackendError::Denied(
+                "managed identity differs from relay authority".into(),
+            ));
+        }
+        Ok(())
+    }
+    async fn exchange(
+        &self,
+        operation: p::managed_boundary_request::Operation,
+    ) -> Result<p::ManagedBoundaryResponse, BackendError> {
+        let response = self
+            .client
+            .call_idempotent(Request::Managed {
+                value: ManagedRequest(p::ManagedBoundaryRequest {
+                    authority: Some(self.authority.clone()),
+                    operation: Some(operation),
+                }),
+            })
+            .await?;
+        match response {
+            Response::Managed { value } => Ok(value.0),
+            _ => Err(BackendError::Descriptor(
+                "managed boundary response missing".into(),
+            )),
+        }
+    }
+    pub async fn describe(&self) -> Result<p::DescribeRuntimeResponse, BackendError> {
+        let response = self
+            .exchange(p::managed_boundary_request::Operation::Describe(
+                p::ManagedDescribe {},
+            ))
+            .await?;
+        let Some(p::managed_boundary_response::Result::Runtime(runtime)) = response.result else {
+            return Err(BackendError::Descriptor(
+                "managed runtime response missing".into(),
+            ));
+        };
+        let binding = runtime
+            .runtime
+            .as_ref()
+            .ok_or_else(|| BackendError::Descriptor("managed runtime binding missing".into()))?;
+        checked::validate_runtime(binding)?;
+        if runtime.gateway_id != self.authority.gateway_id
+            || runtime.workspace_id != self.authority.workspace_id
+            || runtime.subject_id != self.authority.subject_id
+            || runtime.capability != checked::CAPABILITY
+            || binding.sandbox_id != self.authority.sandbox_id
+            || binding.boundary_generation != self.authority.boundary_generation
+            || binding.deployment_profile_sha256 != self.profile
+            || runtime.maximum_output_bytes != checked::MAX_OUTPUT_BYTES
+        {
+            return Err(BackendError::Denied(
+                "managed runtime differs from authenticated deployment".into(),
+            ));
+        }
+        Ok(runtime)
+    }
+    async fn status(
+        &self,
+        identity: &p::CommandIdentity,
+        operation: p::managed_boundary_request::Operation,
+    ) -> Result<p::ExecutionStatus, BackendError> {
+        self.identity(identity)?;
+        let response = self.exchange(operation).await?;
+        let Some(p::managed_boundary_response::Result::Status(status)) = response.result else {
+            return Err(BackendError::Descriptor("managed status missing".into()));
+        };
+        if status.identity.as_ref() != Some(identity)
+            || status.durable_output_sequence > checked::MAX_OUTPUT_CHUNKS
+        {
+            return Err(BackendError::Denied(
+                "managed status identity or watermark mismatch".into(),
+            ));
+        }
+        match p::ExecutionState::try_from(status.state) {
+            Ok(p::ExecutionState::Closed) => checked::validate_receipt(
+                status.terminal.as_ref().ok_or_else(|| {
+                    BackendError::Denied("closed managed execution has no receipt".into())
+                })?,
+                identity,
+            )?,
+            Ok(
+                p::ExecutionState::Admitted
+                | p::ExecutionState::Running
+                | p::ExecutionState::Unresolved,
+            ) if status.terminal.is_none() => {}
+            _ => {
+                return Err(BackendError::Denied(
+                    "invalid managed execution state".into(),
+                ));
+            }
+        }
+        Ok(status)
+    }
+    pub async fn start(&self, start: p::ManagedStart) -> Result<p::ExecutionStatus, BackendError> {
+        let identity = start
+            .identity
+            .clone()
+            .ok_or_else(|| BackendError::Denied("managed start identity missing".into()))?;
+        self.identity(&identity)?;
+        let effective = start
+            .effective_spec
+            .as_ref()
+            .ok_or_else(|| BackendError::Denied("managed effective spec missing".into()))?;
+        let owner = checked::AuthorizedOwner {
+            gateway_id: &self.authority.gateway_id,
+            workspace_id: &self.authority.workspace_id,
+            subject_id: &self.authority.subject_id,
+            runtime: identity.runtime.as_ref().unwrap(),
+        };
+        checked::validate_admission(&identity, effective, &owner)?;
+        self.status(
+            &identity,
+            p::managed_boundary_request::Operation::Start(start),
+        )
+        .await
+    }
+    pub async fn get(
+        &self,
+        identity: p::CommandIdentity,
+    ) -> Result<p::ExecutionStatus, BackendError> {
+        self.status(
+            &identity,
+            p::managed_boundary_request::Operation::Get(p::ManagedGet {
+                identity: Some(identity.clone()),
+            }),
+        )
+        .await
+    }
+    pub async fn cancel(
+        &self,
+        identity: p::CommandIdentity,
+        cancellation_request_id: String,
+    ) -> Result<p::ExecutionStatus, BackendError> {
+        if !uuid::Uuid::parse_str(&cancellation_request_id)
+            .is_ok_and(|id| !id.is_nil() && id.to_string() == cancellation_request_id)
+        {
+            return Err(BackendError::Denied(
+                "invalid managed cancellation ID".into(),
+            ));
+        }
+        self.status(
+            &identity,
+            p::managed_boundary_request::Operation::Cancel(p::ManagedCancel {
+                identity: Some(identity.clone()),
+                cancellation_request_id,
+            }),
+        )
+        .await
+    }
+    pub async fn read(
+        &self,
+        identity: p::CommandIdentity,
+        after_sequence: u64,
+        limit: u32,
+    ) -> Result<p::ManagedOutputBatch, BackendError> {
+        self.identity(&identity)?;
+        if limit == 0 || limit > 256 || after_sequence == u64::MAX {
+            return Err(BackendError::Denied("invalid managed output cursor".into()));
+        }
+        let response = self
+            .exchange(p::managed_boundary_request::Operation::Read(
+                p::ManagedRead {
+                    identity: Some(identity),
+                    after_sequence,
+                    limit,
+                },
+            ))
+            .await?;
+        let Some(p::managed_boundary_response::Result::Output(batch)) = response.result else {
+            return Err(BackendError::Descriptor(
+                "managed output response missing".into(),
+            ));
+        };
+        checked::validate_output_batch(&batch, after_sequence)?;
+        Ok(batch)
+    }
+}
