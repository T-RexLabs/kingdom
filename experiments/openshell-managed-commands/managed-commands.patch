+fn validate_managed_profile_config(config: &DockerComputeConfig) -> CoreResult<()> {
+    let Some(profile) = &config.kingdom_managed_profile else {
+        return Ok(());
+    };
+    profile.validate().map_err(Error::config)?;
+    if config.supervisor_bin.is_some()
+        || config.supervisor_image.as_deref() != Some(profile.supervisor_image.as_str())
+        || config.sandbox_runtime_image.as_deref() != Some(profile.sandbox_runtime_image.as_str())
+    {
+        return Err(Error::config(
+            "managed profile requires exact configured supervisor/runtime image pins and forbids host binary overrides",
+        ));
+    }
+    Ok(())
+}
+
+fn verify_managed_gateway_binary(
+    profile: &openshell_sandbox_backend::kingdom_managed_profile::ManagedProfile,
+) -> CoreResult<()> {
+    // The managed deployment is the embedded driver in the pinned Linux gateway.
+    // /proc/self/exe refers to the running object even if its pathname is replaced.
+    use std::io::Read;
+    let mut file = std::fs::File::open("/proc/self/exe").map_err(|_| {
+        Error::config("managed profile requires a verifiable Linux gateway executable")
+    })?;
+    let mut digest = Sha256::new();
+    let mut buffer = [0_u8; 131072];
+    loop {
+        let count = file
+            .read(&mut buffer)
+            .map_err(|_| Error::config("cannot verify running managed gateway executable"))?;
+        if count == 0 {
+            break;
+        }
+        digest.update(&buffer[..count]);
+    }
+    if format!("{:x}", digest.finalize()) != profile.gateway_binary_sha256 {
+        return Err(Error::config(
+            "running gateway differs from managed profile",
+        ));
+    }
+    Ok(())
+}
+
+fn require_created_image(expected: &str, actual: Option<&str>) -> Result<(), Status> {
+    if !expected
+        .strip_prefix("sha256:")
+        .is_some_and(openshell_sandbox_backend::kingdom_managed_profile::valid_digest)
+        || actual != Some(expected)
+    {
+        return Err(Status::failed_precondition(
+            "created trusted container differs from pinned image content",
+        ));
+    }
+    Ok(())
+}
+
+async fn verify_created_image(
+    docker: &Docker,
+    container: &str,
+    expected: &str,
+) -> Result<(), Status> {
+    let inspected = docker
+        .inspect_container(container, None)
+        .await
+        .map_err(|_| {
+            Status::failed_precondition("cannot verify created trusted container image")
+        })?;
+    require_created_image(expected, inspected.image.as_deref())
+}
