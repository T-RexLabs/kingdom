+#[tonic::async_trait]
+impl p::managed_executions_server::ManagedExecutions for ManagedService {
+    async fn delete_finalized_runtime(
+        &self,
+        request: Request<p::DeleteFinalizedRuntimeRequest>,
+    ) -> Result<Response<p::DeleteFinalizedRuntimeResponse>, Status> {
+        let _slot = self
+            .archive_slots
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| Status::resource_exhausted("managed deletion capacity reached"))?;
+        let principal = super::extract_principal(&request)?;
+        let response = tokio::time::timeout(
+            Duration::from_secs(120),
+            self.delete_finalized(&principal, request.into_inner()),
+        )
+        .await
+        .map_err(|_| Status::deadline_exceeded("managed deletion remains unresolved"))??;
+        Ok(Response::new(response))
+    }
+
+    async fn finalize_runtime(
+        &self,
+        request: Request<p::FinalizeRuntimeRequest>,
+    ) -> Result<Response<p::RuntimeArchive>, Status> {
+        let _slot = self
+            .archive_slots
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| Status::resource_exhausted("managed archival capacity reached"))?;
+        let principal = super::extract_principal(&request)?;
+        Ok(Response::new(
+            tokio::time::timeout(
+                Duration::from_secs(120),
+                self.finalize(&principal, request.into_inner()),
+            )
+            .await
+            .map_err(|_| Status::deadline_exceeded("managed archival remains in progress"))??,
+        ))
+    }
+    async fn get_archived_execution(
+        &self,
+        request: Request<p::ArchivedExecutionRequest>,
+    ) -> Result<Response<p::ExecutionStatus>, Status> {
+        let principal = super::extract_principal(&request)?;
+        let retained = self
+            .archived_request(&principal, &request.into_inner())
+            .await?;
+        Ok(Response::new(status(&retained)?))
+    }
+    type ReadArchivedOutputStream =
+        Pin<Box<dyn tokio_stream::Stream<Item = Result<p::OutputChunk, Status>> + Send>>;
+    async fn read_archived_output(
+        &self,
+        request: Request<p::ReadArchivedOutputRequest>,
+    ) -> Result<Response<Self::ReadArchivedOutputStream>, Status> {
+        let principal = super::extract_principal(&request)?;
+        let req = request.into_inner();
+        let retained = self
+            .archived_request(
+                &principal,
+                req.execution.as_ref().ok_or_else(|| invalid("execution"))?,
+            )
+            .await?;
+        let chunks = self
+            .archived_chunks(&retained, req.after_sequence, req.limit)
+            .await?;
+        Ok(Response::new(Box::pin(tokio_stream::iter(
+            chunks.into_iter().map(Ok),
+        ))))
+    }
+
+    async fn describe_runtime(
+        &self,
+        request: Request<p::DescribeRuntimeRequest>,
+    ) -> Result<Response<p::DescribeRuntimeResponse>, Status> {
+        let principal = super::extract_principal(&request)?;
+        let req = request.into_inner();
+        let owner = self
+            .authorize(&principal, &req.workspace, &req.sandbox)
+            .await?;
+        let _guard = self
+            .state
+            .compute
+            .register_managed_runtime(
+                &owner.runtime,
+                &owner.authority,
+                &req.workspace,
+                &req.sandbox,
+            )
+            .await?;
+        Ok(Response::new(p::DescribeRuntimeResponse {
+            runtime: Some(owner.runtime),
+            capability: checked::CAPABILITY.into(),
+            maximum_output_bytes: checked::MAX_OUTPUT_BYTES,
+            gateway_id: owner.authority.gateway_id,
+            workspace_id: owner.authority.workspace_id,
+            subject_id: owner.authority.subject_id,
+        }))
+    }
+    async fn start_execution(
+        &self,
+        request: Request<p::StartExecutionRequest>,
+    ) -> Result<Response<p::ExecutionStatus>, Status> {
+        let principal = super::extract_principal(&request)?;
+        let req = request.into_inner();
+        checked::validate_start(&req).map_err(invalid)?;
+        let selector = req.execution.as_ref().expect("validated selector");
+        if let Some((retained, owner)) = self.archived_selector(&principal, selector).await? {
+            let prior = identity(&retained)?;
+            let proposed = checked::bind_start(
+                &req,
+                req.command.as_ref().expect("validated command"),
+                &owner.checked(),
+                &prior.boundary_request_id,
+            )
+            .map_err(invalid)?;
+            checked::validate_replay(&prior, &proposed)
+                .map_err(|_| Status::already_exists("managed request identifier conflicts"))?;
+            return Ok(Response::new(status(&retained)?));
+        }
+        let owner = self
+            .authorize(&principal, &selector.workspace, &selector.sandbox)
+            .await?;
+        let effective = req.command.as_ref().expect("validated command").clone();
+        let id = key(&[
+            &owner.authority.gateway_id,
+            &owner.authority.workspace_id,
+            &owner.authority.subject_id,
+            &selector.request_id,
+        ])?;
+        if let Some(record) = self
+            .state
+            .store
+            .get(RECORD_TYPE, &id)
+            .await
+            .map_err(unavailable)?
+        {
+            let retained = decode(&record)?;
+            let previous = identity(&retained)?;
+            let proposed = checked::bind_start(
+                &req,
+                &effective,
+                &owner.checked(),
+                &previous.boundary_request_id,
+            )
+            .map_err(invalid)?;
+            checked::validate_replay(&previous, &proposed)
+                .map_err(|_| Status::already_exists("managed request identifier conflicts"))?;
+            return Ok(Response::new(self.refresh(&id, &retained, &owner).await?));
+        }
+        if owner.terminating {
+            return Err(Status::failed_precondition("workspace is being deleted"));
+        }
+        let identity = checked::bind_start(
+            &req,
+            &effective,
+            &owner.checked(),
+            &uuid::Uuid::new_v4().to_string(),
+        )
+        .map_err(invalid)?;
+        let unresolved = p::ExecutionStatus {
+            identity: Some(identity.clone()),
+            state: p::ExecutionState::Unresolved.into(),
+            terminal: None,
+            durable_output_sequence: 0,
+        };
+        let retained = Retained {
+            original: req.encode_to_vec(),
+            effective: effective.encode_to_vec(),
+            identity: identity.encode_to_vec(),
+            status: unresolved.encode_to_vec(),
+        };
+        let bytes = serde_json::to_vec(&retained).map_err(unavailable)?;
+        let _admission = self
+            .state
+            .compute
+            .retain_managed_runtime(
+                &owner.runtime,
+                &owner.authority,
+                &selector.workspace,
+                &selector.sandbox,
+                &id,
+            )
+            .await?;
+        // Only this successfully committed first writer may forward Start. A
+        // lost commit response or concurrent replay never grants dispatch.
+        self.state
+            .store
+            .put_if(
+                RECORD_TYPE,
+                &id,
+                &id,
+                "",
+                &bytes,
+                None,
+                WriteCondition::MustCreate,
+            )
+            .await
+            .map_err(|_| {
+                Status::aborted("managed start admission uncertain; query retained execution")
+            })?;
+        let reply = self
+            .exchange(
+                &owner.authority,
+                p::managed_boundary_request::Operation::Start(p::ManagedStart {
+                    identity: Some(identity),
+                    effective_spec: Some(effective),
+                }),
+            )
+            .await;
+        let result = match reply {
+            Ok(p::ManagedBoundaryResponse {
+                result: Some(p::managed_boundary_response::Result::Status(value)),
+            }) => self.save_status(&id, value).await?,
+            Ok(_) => return Err(corrupt()),
+            Err(_) => unresolved,
+        };
+        Ok(Response::new(result))
+    }
+    async fn get_execution(
+        &self,
+        request: Request<p::GetExecutionRequest>,
+    ) -> Result<Response<p::ExecutionStatus>, Status> {
+        let principal = super::extract_principal(&request)?;
+        let selector = request
+            .into_inner()
+            .execution
+            .ok_or_else(|| invalid("selector"))?;
+        checked::validate_selector(&selector).map_err(invalid)?;
+        if let Some((retained, _)) = self.archived_selector(&principal, &selector).await? {
+            return Ok(Response::new(status(&retained)?));
+        }
+        let owner = self
+            .authorize(&principal, &selector.workspace, &selector.sandbox)
+            .await?;
+        let (id, _, retained) = self.retained(&selector, &owner).await?;
+        Ok(Response::new(self.refresh(&id, &retained, &owner).await?))
+    }
+    async fn cancel_execution(
+        &self,
+        request: Request<p::CancelExecutionRequest>,
+    ) -> Result<Response<p::ExecutionStatus>, Status> {
+        let principal = super::extract_principal(&request)?;
+        let req = request.into_inner();
+        let cancellation = uuid::Uuid::parse_str(&req.request_id).map_err(invalid)?;
+        if cancellation.is_nil() || cancellation.to_string() != req.request_id {
+            return Err(invalid("cancellation id"));
+        }
+        let selector = req.execution.ok_or_else(|| invalid("selector"))?;
+        checked::validate_selector(&selector).map_err(invalid)?;
+        if let Some((retained, _)) = self.archived_selector(&principal, &selector).await? {
+            return Ok(Response::new(status(&retained)?));
+        }
+        let owner = self
+            .authorize(&principal, &selector.workspace, &selector.sandbox)
+            .await?;
+        let (id, _, retained) = self.retained(&selector, &owner).await?;
+        let cancel_key = key(&[
+            CANCEL_TYPE,
+            &owner.authority.gateway_id,
+            &owner.authority.workspace_id,
+            &owner.authority.subject_id,
+            &req.request_id,
+        ])?;
+        let cancel = p::ManagedCancel {
+            identity: Some(identity(&retained)?),
+            cancellation_request_id: req.request_id,
+        };
+        let payload = cancel.encode_to_vec();
+        if let Some(old) = self
+            .state
+            .store
+            .get(CANCEL_TYPE, &cancel_key)
+            .await
+            .map_err(unavailable)?
+        {
+            if old.payload != payload {
+                return Err(Status::already_exists(
+                    "managed cancellation identifier conflicts",
+                ));
+            }
+            return Ok(Response::new(self.refresh(&id, &retained, &owner).await?));
+        }
+        self.state
+            .store
+            .put_if(
+                CANCEL_TYPE,
+                &cancel_key,
+                &cancel_key,
+                "",
+                &payload,
+                None,
+                WriteCondition::MustCreate,
+            )
+            .await
+            .map_err(|_| Status::aborted("managed cancellation admission uncertain"))?;
+        let value = match self
+            .exchange(
+                &owner.authority,
+                p::managed_boundary_request::Operation::Cancel(cancel),
+            )
+            .await
+        {
+            Ok(p::ManagedBoundaryResponse {
+                result: Some(p::managed_boundary_response::Result::Status(value)),
+            }) => self.save_status(&id, value).await?,
+            Ok(_) => return Err(corrupt()),
+            Err(_) => status(&retained)?,
+        };
+        Ok(Response::new(value))
+    }
+    type ReadOutputStream =
+        Pin<Box<dyn tokio_stream::Stream<Item = Result<p::OutputChunk, Status>> + Send>>;
+    async fn read_output(
+        &self,
+        request: Request<p::ReadOutputRequest>,
+    ) -> Result<Response<Self::ReadOutputStream>, Status> {
+        let principal = super::extract_principal(&request)?;
+        let req = request.into_inner();
+        if req.limit == 0 || req.limit > 64 {
+            return Err(invalid("output limit"));
+        }
+        let selector = req.execution.ok_or_else(|| invalid("selector"))?;
+        checked::validate_selector(&selector).map_err(invalid)?;
+        if let Some((retained, _)) = self.archived_selector(&principal, &selector).await? {
+            let chunks = self
+                .archived_chunks(&retained, req.after_sequence, req.limit)
+                .await?;
+            return Ok(Response::new(Box::pin(tokio_stream::iter(
+                chunks.into_iter().map(Ok),
+            ))));
+        }
+        let owner = self
+            .authorize(&principal, &selector.workspace, &selector.sandbox)
+            .await?;
+        let (_, _, retained) = self.retained(&selector, &owner).await?;
+        let reply = self
+            .exchange(
+                &owner.authority,
+                p::managed_boundary_request::Operation::Read(p::ManagedRead {
+                    identity: Some(identity(&retained)?),
+                    after_sequence: req.after_sequence,
+                    limit: req.limit,
+                }),
+            )
+            .await?;
+        let Some(p::managed_boundary_response::Result::Output(batch)) = reply.result else {
+            return Err(corrupt());
+        };
+        checked::validate_output_batch(&batch, req.after_sequence).map_err(|_| corrupt())?;
+        if batch.chunks.len() > req.limit as usize {
+            return Err(corrupt());
+        }
+        Ok(Response::new(Box::pin(tokio_stream::iter(
+            batch.chunks.into_iter().map(Ok),
+        ))))
+    }
+}
