+        let receipt = value.terminal.as_ref().ok_or_else(|| {
+            Status::failed_precondition("managed execution closure remains unresolved")
+        })?;
+        let output = receipt.output.as_ref().ok_or_else(corrupt)?;
+        if output.total_bytes > spec.output_limit_bytes {
+            return Err(corrupt());
+        }
+        self.save_status(id, value.clone()).await?;
+        let mut sequence = 0;
+        let mut total = 0u64;
+        let mut framed = Vec::new();
+        let mut verified_chunks = Vec::new();
+        while sequence < output.last_sequence {
+            let reply = self
+                .exchange(
+                    &owner.authority,
+                    p::managed_boundary_request::Operation::Read(p::ManagedRead {
+                        identity: Some(identity.clone()),
+                        after_sequence: sequence,
+                        limit: 64,
+                    }),
