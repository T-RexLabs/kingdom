+// SPDX-License-Identifier: Apache-2.0
+//! Trusted, resumable evidence archival. No public input can assert closure or
+//! release retention. Immutable chunks and command records precede the manifest.
+use super::*;
+use crate::auth::workspace_authz::authorize_sandbox_workspace;
+use crate::compute::managed_retention as retention;
+
+// Private fields prevent release based on a raw public manifest or caller flag.
+// Only the trusted archival path constructs this capability, after persistence.
+pub(crate) struct VerifiedArchive {
+    binding: p::RuntimeBinding,
+    id: String,
+}
+impl VerifiedArchive {
+    pub(crate) fn binding(&self) -> &p::RuntimeBinding {
+        &self.binding
+    }
+    pub(crate) fn id(&self) -> &str {
+        &self.id
+    }
+}
+
+const COMMAND_ARCHIVE_TYPE: &str = "KingdomManagedCommandArchiveV1";
+const CHUNK_TYPE: &str = "KingdomManagedOutputArchiveV1";
+fn command_key(id: &str) -> String {
+    format!("kingdom-managed-command-archive:{id}")
+}
+fn chunk_key(id: &str, sequence: u64) -> String {
+    format!("kingdom-managed-output:{id}:{sequence}")
+}
+fn record_id(identity: &p::CommandIdentity) -> Result<String, Status> {
+    key(&[
+        &identity.gateway_id,
+        &identity.workspace_id,
+        &identity.subject_id,
+        &identity.request_id,
+    ])
+}
+pub(super) async fn immutable(
+    store: &crate::persistence::Store,
+    kind: &str,
+    id: &str,
+    bytes: &[u8],
+) -> Result<(), Status> {
+    if let Some(existing) = store.get(kind, id).await.map_err(unavailable)? {
+        return if existing.payload == bytes {
+            Ok(())
+        } else {
+            Err(corrupt())
+        };
+    }
+    match store
+        .put_if(kind, id, id, "", bytes, None, WriteCondition::MustCreate)
+        .await
+    {
+        Ok(_) => Ok(()),
+        Err(error) => {
+            if let Some(existing) = store.get(kind, id).await.map_err(unavailable)? {
+                if existing.payload == bytes {
+                    return Ok(());
+                }
+            }
+            Err(unavailable(error))
+        }
+    }
+}
+fn closed(retained: &Retained) -> Result<p::TerminalReceipt, Status> {
+    let value = status(retained)?;
+    validate_status(&value, &identity(retained)?)?;
+    value
+        .terminal
+        .ok_or_else(|| Status::failed_precondition("managed execution closure remains unresolved"))
+}
+impl ManagedService {
+    pub(super) async fn archive_authorize(
+        &self,
+        principal: &Principal,
+        workspace_name: &str,
+        workspace_id: &str,
+        gateway_id: &str,
+        role: MinWorkspaceRole,
+    ) -> Result<String, Status> {
+        let subject = self.subject(principal)?;
+        if self
+            .state
+            .config
+            .gateway_jwt
+            .as_ref()
+            .map(|g| g.gateway_id.as_str())
+            != Some(gateway_id)
+        {
+            return Err(Status::permission_denied(
+                "archive gateway identity mismatch",
+            ));
+        }
+        let workspace = self
+            .state
+            .store
+            .get_message_by_name::<Workspace>("", workspace_name)
+            .await
+            .map_err(unavailable)?;
+        match workspace {
+            Some(workspace) => {
+                if workspace.metadata.as_ref().map(|m| m.id.as_str()) != Some(workspace_id) {
+                    return Err(Status::permission_denied(
+                        "archive workspace identity changed",
+                    ));
+                }
+                authorize_sandbox_workspace(
+                    &self.state.store,
+                    &self.state.admin_role,
+                    principal,
+                    workspace_name,
+                    role,
+                )
+                .await?;
+            }
+            None if matches!(principal, Principal::Operator(_)) => {}
+            None => {
+                return Err(Status::permission_denied(
+                    "archive workspace authority unavailable",
+                ));
+            }
+        }
+        Ok(subject)
+    }
+    pub(super) async fn finalize(
+        &self,
+        principal: &Principal,
+        request: p::FinalizeRuntimeRequest,
+    ) -> Result<p::RuntimeArchive, Status> {
+        let binding = request.runtime.as_ref().ok_or_else(|| invalid("runtime"))?;
+        checked::validate_runtime(binding).map_err(invalid)?;
+        let (record, _) = retention::read_retention(&self.state.store, &binding.sandbox_id)
+            .await?
+            .ok_or_else(|| Status::not_found("managed runtime not found"))?;
+        if record.binding != binding.encode_to_vec()
+            || record.workspace_name != request.workspace
+            || record.sandbox_name != request.sandbox
+        {
+            return Err(Status::failed_precondition(
+                "managed runtime identity changed",
+            ));
+        }
+        self.archive_authorize(
+            principal,
+            &record.workspace_name,
+            &record.workspace_id,
+            &record.gateway_id,
+            MinWorkspaceRole::Admin,
+        )
+        .await?;
+        if record.phase == retention::Phase::Released {
+            let archive = retention::read_archive(
+                &self.state.store,
+                record.archive_id.as_deref().ok_or_else(corrupt)?,
+            )
+            .await?;
+            return p::RuntimeArchive::decode(archive.proof.as_slice()).map_err(|_| corrupt());
+        }
+        let owner = self
+            .authorize(principal, &request.workspace, &request.sandbox)
+            .await?;
+        if owner.runtime != *binding {
+            return Err(Status::failed_precondition(
+                "managed runtime identity changed",
+            ));
+        }
+        let sealed = self.state.compute.seal_managed_runtime(binding).await?;
+        let mut commands = Vec::new();
+        for id in &sealed.commands {
+            let archived = self.archive_one(id, &sealed).await?;
+            let receipt = closed(&archived)?;
+            commands.push(p::ArchivedCommand {
+                identity: receipt.identity,
+                receipt_sha256: receipt.receipt_sha256,
+                output: receipt.output,
+            });
+        }
+        commands.sort_by(|a, b| {
+            a.identity
+                .as_ref()
+                .map(|v| &v.boundary_request_id)
+                .cmp(&b.identity.as_ref().map(|v| &v.boundary_request_id))
+        });
+        let manifest = p::RuntimeArchiveManifest {
+            schema_version: 2,
+            subject_id: sealed.subject_id.clone(),
+            gateway_id: sealed.gateway_id.clone(),
+            workspace_id: sealed.workspace_id.clone(),
+            runtime: Some(binding.clone()),
+            commands,
+        };
+        let mut encoded = retention::ARCHIVE_DOMAIN.to_vec();
+        encoded.extend(manifest.encode_to_vec());
+        let digest = openshell_crypto::sha256(&encoded).map_err(unavailable)?;
+        let archive = p::RuntimeArchive {
+            archive_id: hex::encode(&digest),
+            manifest: Some(manifest),
+            manifest_sha256: digest.to_vec(),
+        };
+        retention::verify_archive(&archive)?;
+        let stored = retention::StoredArchive {
+            proof: archive.encode_to_vec(),
+            workspace_name: sealed.workspace_name,
+            sandbox_name: sealed.sandbox_name,
+        };
+        immutable(
+            &self.state.store,
+            retention::ARCHIVE_TYPE,
