+                Retention {
+                    binding: binding.encode_to_vec(),
+                    gateway_id: authority.gateway_id.clone(),
+                    workspace_id: authority.workspace_id.clone(),
+                    subject_id: authority.subject_id.clone(),
+                    workspace_name: workspace.into(),
+                    sandbox_name: sandbox.into(),
+                    commands: BTreeSet::new(),
+                    phase: Phase::Active,
+                    archive_id: None,
+                },
+                WriteCondition::MustCreate,
+            )
