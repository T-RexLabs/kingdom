+            || record.gateway_id != authority.gateway_id
+            || record.workspace_id != authority.workspace_id
+            || record.subject_id != authority.subject_id
+            || record.workspace_name != workspace
+            || record.sandbox_name != sandbox
+            || record.phase != Phase::Active
