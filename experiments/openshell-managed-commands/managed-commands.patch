+        ) {
+            return;
+        }
+        let mut sibling = child("sleep 60");
+        let mut leader = child("sleep 60 & wait");
+        killpg(
+            Pid::from_raw(i32::try_from(leader.id()).unwrap()),
+            Signal::SIGKILL,
