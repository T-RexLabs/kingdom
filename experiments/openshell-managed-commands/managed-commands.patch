+// SPDX-License-Identifier: Apache-2.0
+//! Deletion of finalized immutable runtime identities. A reusable name is never
+//! used to select the object, including after restart or a lost response.
+use super::*;
+use crate::compute::managed_retention as retention;
+use openshell_core::proto::DeletionOutcome;
+
+const DELETION_TYPE: &str = "KingdomManagedRuntimeDeletionV1";
+const DOMAIN: &[u8] = b"kingdom.openshell.runtime-deletion.v1\0";
+fn deletion_key(archive: &str) -> String {
+    format!("kingdom-managed-deletion:{archive}")
+}
+fn digest(receipt: &p::RuntimeDeletionReceipt) -> Result<Vec<u8>, Status> {
+    let mut value = receipt.clone();
+    value.receipt_sha256.clear();
+    let mut bytes = DOMAIN.to_vec();
+    bytes.extend(value.encode_to_vec());
+    Ok(openshell_crypto::sha256(&bytes)
+        .map_err(unavailable)?
+        .to_vec())
+}
+impl ManagedService {
+    pub(super) async fn delete_finalized(
+        &self,
+        principal: &Principal,
+        request: p::DeleteFinalizedRuntimeRequest,
+    ) -> Result<p::DeleteFinalizedRuntimeResponse, Status> {
+        let binding = request.runtime.as_ref().ok_or_else(|| invalid("runtime"))?;
+        checked::validate_runtime(binding).map_err(invalid)?;
+        let stored = retention::read_archive(&self.state.store, &request.archive_id).await?;
+        let archive = p::RuntimeArchive::decode(stored.proof.as_slice()).map_err(|_| corrupt())?;
+        let manifest = archive.manifest.as_ref().ok_or_else(corrupt)?;
+        if manifest.runtime.as_ref() != Some(binding) {
+            return Err(Status::failed_precondition(
+                "managed runtime identity changed",
+            ));
+        }
+        let subject = self
+            .archive_authorize(
+                principal,
+                &stored.workspace_name,
+                &manifest.workspace_id,
+                &manifest.gateway_id,
+                MinWorkspaceRole::Admin,
+            )
+            .await?;
+        if manifest.subject_id != subject
+            || manifest.commands.iter().any(|command| {
+                command
+                    .identity
+                    .as_ref()
+                    .is_none_or(|id| id.subject_id != subject)
+            })
+        {
+            return Err(Status::permission_denied(
+                "archive subject identity mismatch",
+            ));
+        }
+        let (retained, _) = retention::read_retention(&self.state.store, &binding.sandbox_id)
+            .await?
+            .ok_or_else(corrupt)?;
+        if retained.phase != retention::Phase::Released
+            || retained.binding != binding.encode_to_vec()
+            || retained.archive_id.as_deref() != Some(request.archive_id.as_str())
+            || retained.subject_id != manifest.subject_id
+            || retained.workspace_id != manifest.workspace_id
+            || retained.gateway_id != manifest.gateway_id
+            || retained.workspace_name != stored.workspace_name
+            || retained.sandbox_name != stored.sandbox_name
+        {
+            return Err(Status::failed_precondition(
+                "managed runtime archive not released",
+            ));
+        }
+        let mut receipt = p::RuntimeDeletionReceipt {
+            schema_version: 1,
+            gateway_id: manifest.gateway_id.clone(),
+            workspace_id: manifest.workspace_id.clone(),
+            subject_id: subject,
+            runtime: Some(binding.clone()),
+            archive_id: request.archive_id.clone(),
+            receipt_sha256: Vec::new(),
+        };
+        receipt.receipt_sha256 = digest(&receipt)?;
+        let key = deletion_key(&request.archive_id);
+        if let Some(row) = self
+            .state
+            .store
+            .get(DELETION_TYPE, &key)
+            .await
+            .map_err(unavailable)?
+        {
+            if row.payload != receipt.encode_to_vec() {
+                return Err(corrupt());
+            }
+            return Ok(p::DeleteFinalizedRuntimeResponse {
+                state: p::RuntimeDeletionState::Absent as i32,
+                receipt: Some(receipt),
+            });
+        }
+        // compute owns the immutable ID lifecycle lock and rereads that ID
+        // before mutation. A replacement with the old name is not a target.
+        let result = self
+            .state
+            .compute
+            .delete_sandbox_by_id(&binding.sandbox_id, &stored.sandbox_name)
+            .await?;
+        if result.sandbox_id != binding.sandbox_id {
+            return Err(corrupt());
+        }
+        if result.outcome != DeletionOutcome::Completed {
+            return Ok(p::DeleteFinalizedRuntimeResponse {
+                state: p::RuntimeDeletionState::Pending as i32,
+                receipt: None,
+            });
+        }
+        // Absence must survive a lost reply before any terminal result escapes.
+        archive::immutable(
+            &self.state.store,
+            DELETION_TYPE,
+            &key,
+            &receipt.encode_to_vec(),
+        )
+        .await?;
+        Ok(p::DeleteFinalizedRuntimeResponse {
+            state: p::RuntimeDeletionState::Absent as i32,
+            receipt: Some(receipt),
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn deletion_receipt_matches_go_canonical_vector() {
+        let wire = hex::decode("").unwrap();
+        let receipt = p::RuntimeDeletionReceipt::decode(wire.as_slice()).unwrap();
+        assert_eq!(
+            hex::encode(digest(&receipt).unwrap()),
+            "156646f2b900a29158d18158e9e82d01a4d5c16d62124d1f44859cfa4996a904"
+        );
+        assert_eq!(receipt.receipt_sha256, digest(&receipt).unwrap());
+        let mut cleared = receipt;
+        cleared.receipt_sha256.clear();
+        assert_eq!(
+            hex::encode(cleared.encode_to_vec()),
+            ""
+        );
+    }
+}
