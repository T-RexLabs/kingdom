+// SPDX-License-Identifier: Apache-2.0
+//! Boundary-owned durable managed admissions. An admission is never evicted or
+//! re-executed. Disposal of the enclosing sandbox is a separate retention step.
+
+use crate::kingdom_managed::{
+    MAX_CHUNK_BYTES, MAX_CONTROL_BYTES, MAX_OUTPUT_BATCH_BYTES, MAX_OUTPUT_CHUNKS,
+    validate_output_chunk, validate_receipt, validate_replay,
+};
+use openshell_core::proto::kingdom_managed as p;
+use prost::Message;
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Read, Write};
+use std::os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex, MutexGuard};
+
+pub const MAX_COMMANDS: usize = 64;
+const MAX_FRAME_BYTES: usize = MAX_CHUNK_BYTES + 32;
+
+fn invalid(message: impl ToString) -> io::Error {
+    io::Error::other(message.to_string())
+}
+fn lock<T>(value: &Mutex<T>) -> io::Result<MutexGuard<'_, T>> {
+    value
+        .lock()
+        .map_err(|_| invalid("managed store lock poisoned"))
+}
+fn digest(bytes: &[u8]) -> io::Result<Vec<u8>> {
+    openshell_crypto::sha256(bytes)
+        .map(|hash| hash.to_vec())
+        .map_err(invalid)
+}
+fn key(identity: &p::CommandIdentity) -> io::Result<String> {
+    // Exclude subject and payload from the key: a collision must reject changed
+    // ownership/content rather than create a second command under the same ID.
+    let runtime = identity
+        .runtime
+        .as_ref()
+        .ok_or_else(|| invalid("runtime identity missing"))?;
+    let mut scope = Vec::new();
+    for field in [
+        &identity.gateway_id,
+        &identity.workspace_id,
+        &runtime.sandbox_id,
+        &runtime.boundary_generation,
+        &identity.request_id,
+    ] {
+        scope.extend_from_slice(&(field.len() as u64).to_be_bytes());
+        scope.extend_from_slice(field.as_bytes());
+    }
+    Ok(digest(&scope)?
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect())
+}
+fn open_read(path: &Path) -> io::Result<File> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)?;
+    let meta = file.metadata()?;
+    if !meta.is_file()
+        || meta.uid() != rustix::process::geteuid().as_raw()
+        || meta.mode() & 0o777 != 0o600
+    {
+        return Err(invalid("managed record is not a private regular file"));
+    }
+    Ok(file)
+}
+fn read_message<M: Message + Default>(path: &Path) -> io::Result<M> {
+    let mut file = open_read(path)?;
+    if file.metadata()?.len() > MAX_CONTROL_BYTES as u64 {
+        return Err(invalid("managed record exceeds control limit"));
+    }
+    let mut bytes = Vec::new();
+    file.read_to_end(&mut bytes)?;
+    M::decode(bytes.as_slice()).map_err(invalid)
+}
+fn persist<M: Message>(path: &Path, value: &M) -> io::Result<()> {
+    let bytes = value.encode_to_vec();
+    if bytes.len() > MAX_CONTROL_BYTES {
+        return Err(invalid("managed record exceeds control limit"));
+    }
+    // A failed partial create is retained as an unresolved tombstone.
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)?;
+    file.write_all(&bytes)?;
+    file.sync_all()?;
+    File::open(
+        path.parent()
+            .ok_or_else(|| invalid("missing record parent"))?,
+    )?
+    .sync_all()
+}
+
+fn validate_stored(start: &p::ManagedStart) -> io::Result<()> {
+    let identity = start
+        .identity
+        .as_ref()
+        .ok_or_else(|| invalid("managed identity missing"))?;
+    let spec = start
+        .effective_spec
+        .as_ref()
+        .ok_or_else(|| invalid("managed spec missing"))?;
+    let runtime = identity
+        .runtime
+        .as_ref()
+        .ok_or_else(|| invalid("managed runtime missing"))?;
+    let owner = crate::kingdom_managed::AuthorizedOwner {
+        gateway_id: &identity.gateway_id,
+        workspace_id: &identity.workspace_id,
+        subject_id: &identity.subject_id,
+        runtime,
+    };
+    crate::kingdom_managed::validate_admission(identity, spec, &owner).map_err(invalid)
+}
+
+struct Inner {
+    root: PathBuf,
+    serial: Mutex<()>,
+}
+#[derive(Clone)]
+pub struct Store(Arc<Inner>);
+pub enum Admission {
+    New(OutputWriter),
+    Existing(p::ExecutionStatus),
+}
+
+impl Store {
+    pub fn open(root: &Path) -> io::Result<Self> {
+        let owner = rustix::process::geteuid().as_raw();
+        for path in root.ancestors().skip(1) {
+            let meta = fs::symlink_metadata(path)?;
+            if !meta.is_dir()
+                || (meta.uid() != 0 && meta.uid() != owner)
+                || meta.mode() & 0o022 != 0
+            {
+                return Err(invalid("managed store parent is not trusted"));
+            }
+        }
+        match fs::DirBuilder::new().mode(0o700).create(root) {
+            Ok(()) => File::open(
+                root.parent()
+                    .ok_or_else(|| invalid("missing store parent"))?,
+            )?
+            .sync_all()?,
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+            Err(error) => return Err(error),
+        }
+        let meta = fs::symlink_metadata(root)?;
+        if !meta.is_dir() || meta.uid() != owner || meta.mode() & 0o777 != 0o700 {
+            return Err(invalid("managed store is not private"));
+        }
+        Ok(Self(Arc::new(Inner {
+            root: root.into(),
+            serial: Mutex::new(()),
+        })))
+    }
+    fn path(&self, identity: &p::CommandIdentity, suffix: &str) -> io::Result<PathBuf> {
+        Ok(self.0.root.join(format!("{}.{suffix}", key(identity)?)))
+    }
+    /// The caller must validate identity/effective spec against its authenticated
+    /// session and hold its generation admission lock before this operation.
+    pub fn reserve(&self, start: &p::ManagedStart) -> io::Result<Admission> {
+        let _guard = lock(&self.0.serial)?;
+        let identity = start
+            .identity
+            .as_ref()
+            .ok_or_else(|| invalid("managed identity missing"))?;
+        let spec = start
+            .effective_spec
+            .as_ref()
+            .ok_or_else(|| invalid("managed spec missing"))?;
+        validate_stored(start)?;
+        let path = self.path(identity, "intent")?;
+        match fs::symlink_metadata(&path) {
+            Ok(_) => return self.get_locked(identity).map(Admission::Existing),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error),
+        }
+        if fs::read_dir(&self.0.root)?.try_fold(0usize, |count, entry| -> io::Result<usize> {
+            Ok(count
+                + usize::from(
+                    entry?
+                        .path()
+                        .extension()
+                        .is_some_and(|extension| extension == "intent"),
+                ))
+        })? >= MAX_COMMANDS
+        {
+            return Err(invalid("managed admission retention limit reached"));
+        }
+        persist(&path, start)?;
+        let output = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(self.path(identity, "output")?)?;
+        output.sync_all()?;
+        File::open(&self.0.root)?.sync_all()?;
+        Ok(Admission::New(OutputWriter {
+            store: self.clone(),
+            identity: identity.clone(),
+            output,
+            limit: spec.output_limit_bytes,
+            bytes: 0,
+            sequence: 0,
+            failed: false,
+            truncated: false,
+        }))
+    }
+    fn intent_locked(&self, identity: &p::CommandIdentity) -> io::Result<p::ManagedStart> {
+        let start: p::ManagedStart = read_message(&self.path(identity, "intent")?)?;
+        validate_stored(&start)?;
+        validate_replay(
+            start
+                .identity
+                .as_ref()
+                .ok_or_else(|| invalid("managed identity missing"))?,
+            identity,
+        )
+        .map_err(invalid)?;
+        Ok(start)
+    }
+    /// Retain one cancellation identity before signaling. Reusing its UUID for
+    /// another command fails; a later distinct UUID cannot grow storage without
+    /// bound. Closed commands retain the cancellation identity without signaling.
+    pub fn cancel(&self, request: &p::ManagedCancel) -> io::Result<bool> {
+        let _guard = lock(&self.0.serial)?;
+        let identity = request
+            .identity
+            .as_ref()
+            .ok_or_else(|| invalid("cancel identity missing"))?;
+        if !uuid::Uuid::parse_str(&request.cancellation_request_id)
+            .is_ok_and(|id| !id.is_nil() && id.to_string() == request.cancellation_request_id)
+        {
+            return Err(invalid("invalid cancellation ID"));
+        }
+        let status = self.get_locked(identity)?;
+        let mut scope = identity.clone();
+        scope.request_id = request.cancellation_request_id.clone();
+        let index = self.path(&scope, "cancelindex")?;
+        match read_message::<p::ManagedCancel>(&index) {
+            Ok(existing) if existing != *request => {
+                return Err(invalid("cancellation ID reused for another target"));
+            }
+            Ok(_) => {}
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                if fs::read_dir(&self.0.root)?.try_fold(
+                    0usize,
+                    |count, entry| -> io::Result<usize> {
+                        Ok(count
+                            + usize::from(
+                                entry?
+                                    .path()
+                                    .extension()
+                                    .is_some_and(|extension| extension == "cancelindex"),
+                            ))
+                    },
+                )? >= MAX_COMMANDS
+                {
+                    return Err(invalid("cancellation retention limit reached"));
+                }
+                // Check the command marker before admitting another index.
+                match read_message::<p::ManagedCancel>(&self.path(identity, "cancel")?) {
+                    Ok(existing) if existing == *request => {}
+                    Ok(_) => return Err(invalid("command already has a cancellation identity")),
+                    Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+                    Err(error) => return Err(error),
+                }
+                persist(&index, request)?;
+            }
+            Err(error) => return Err(error),
+        }
+        let marker = self.path(identity, "cancel")?;
+        match read_message::<p::ManagedCancel>(&marker) {
+            Ok(existing) if existing == *request => {}
+            Ok(_) => return Err(invalid("command already has a cancellation identity")),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => persist(&marker, request)?,
+            Err(error) => return Err(error),
+        }
+        Ok(status.terminal.is_none())
+    }
+
+    pub fn get(&self, identity: &p::CommandIdentity) -> io::Result<p::ExecutionStatus> {
+        let _guard = lock(&self.0.serial)?;
+        self.get_locked(identity)
+    }
+    fn get_locked(&self, identity: &p::CommandIdentity) -> io::Result<p::ExecutionStatus> {
+        self.intent_locked(identity)?;
+        let terminal = match read_message::<p::TerminalReceipt>(&self.path(identity, "terminal")?) {
+            Ok(receipt) => Some(receipt),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => None,
+            Err(error) => return Err(error),
+        };
+        let manifest = self.scan_locked(identity, |_, _| Ok(()))?;
+        if let Some(receipt) = &terminal {
+            validate_receipt(receipt, identity).map_err(invalid)?;
+            let retained = receipt
+                .output
+                .as_ref()
+                .ok_or_else(|| invalid("terminal manifest missing"))?;
+            if retained.total_bytes != manifest.total_bytes
+                || retained.last_sequence != manifest.last_sequence
+                || retained.sha256 != manifest.sha256
+            {
+                return Err(invalid("terminal output differs from durable records"));
+            }
+        }
+        Ok(p::ExecutionStatus {
+            identity: Some(identity.clone()),
+            state: if terminal.is_some() {
+                p::ExecutionState::Closed
+            } else {
+                p::ExecutionState::Unresolved
+            }
+            .into(),
+            terminal,
+            durable_output_sequence: manifest.last_sequence,
+        })
+    }
+    fn scan_locked(
+        &self,
+        identity: &p::CommandIdentity,
+        mut visit: impl FnMut(&p::OutputChunk, usize) -> io::Result<()>,
+    ) -> io::Result<p::OutputManifest> {
+        let start = self.intent_locked(identity)?;
+        let limit = start
+            .effective_spec
+            .ok_or_else(|| invalid("stored managed spec missing"))?
+            .output_limit_bytes;
+        let mut file = open_read(&self.path(identity, "output")?)?;
+        let mut hasher = openshell_crypto::sha256_digest().map_err(invalid)?;
+        let mut bytes = 0u64;
+        let mut sequence = 0u64;
+        loop {
+            let mut length = [0u8; 4];
+            let first = file.read(&mut length[..1])?;
+            if first == 0 {
+                break;
+            }
+            file.read_exact(&mut length[1..])?;
+            let length_value = u32::from_be_bytes(length) as usize;
+            if length_value > MAX_FRAME_BYTES || sequence >= MAX_OUTPUT_CHUNKS {
+                return Err(invalid("retained output exceeds bounds"));
+            }
+            let mut encoded = vec![0u8; length_value];
+            file.read_exact(&mut encoded)?;
+            let chunk = p::OutputChunk::decode(encoded.as_slice()).map_err(invalid)?;
+            validate_output_chunk(&chunk, sequence + 1).map_err(invalid)?;
+            sequence += 1;
+            bytes = bytes
+                .checked_add(chunk.data.len() as u64)
+                .ok_or_else(|| invalid("output size overflow"))?;
+            if bytes > limit {
+                return Err(invalid("retained output exceeds requested limit"));
+            }
+            hasher.update(&length).map_err(invalid)?;
+            hasher.update(&encoded).map_err(invalid)?;
+            visit(&chunk, encoded.len())?;
+        }
+        Ok(p::OutputManifest {
+            last_sequence: sequence,
+            total_bytes: bytes,
+            sha256: hasher.finish().map_err(invalid)?.to_vec(),
+            complete: false,
+            gap: false,
+            truncated: false,
+        })
+    }
+    pub fn read(
+        &self,
+        identity: &p::CommandIdentity,
+        after: u64,
+        limit: u32,
+    ) -> io::Result<p::ManagedOutputBatch> {
+        if limit == 0 || limit > 256 || after == u64::MAX {
+            return Err(invalid("invalid managed output read"));
+        }
+        let _guard = lock(&self.0.serial)?;
+        let mut chunks = Vec::new();
+        let mut encoded_bytes = 64usize;
+        let mut full = false;
+        let manifest = self.scan_locked(identity, |chunk, encoded_len| {
+            if chunk.sequence > after && !full {
+                if chunks.len() >= limit as usize
+                    || encoded_bytes + encoded_len + 16 > MAX_OUTPUT_BATCH_BYTES
+                {
+                    full = true;
+                } else {
+                    chunks.push(chunk.clone());
+                    encoded_bytes += encoded_len + 16;
+                }
+            }
+            Ok(())
+        })?;
+        let next_sequence = chunks.last().map_or(after + 1, |chunk| chunk.sequence + 1);
+        let batch = p::ManagedOutputBatch {
+            chunks,
+            next_sequence,
+            durable_output_sequence: manifest.last_sequence,
+        };
+        crate::kingdom_managed::validate_output_batch(&batch, after).map_err(invalid)?;
+        Ok(batch)
+    }
+}
