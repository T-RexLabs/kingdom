+// SPDX-License-Identifier: Apache-2.0
+//! Bounded internal service on a gateway-created relay, never a host listener.
+use openshell_core::proto::kingdom_managed as p;
+use openshell_isolation_interface::contract::BackendError;
+use openshell_sandbox_backend::{BoundaryLoopbackConnector, BoundaryManagedClient};
+use std::{
+    pin::Pin,
+    sync::{Arc, OnceLock},
+    task::{Context, Poll},
+    time::Duration,
+};
+use tokio::io::{AsyncRead, AsyncWrite, DuplexStream, ReadBuf};
+use tokio::sync::Semaphore;
+use tonic::{Request, Response, Status};
+
+const MAX_MESSAGE: usize = 1024 * 1024;
+static RELAYS: OnceLock<Arc<Semaphore>> = OnceLock::new();
+
+struct Service {
+    authority: p::ManagedAuthority,
+    client: BoundaryManagedClient,
+}
+
+fn status(error: BackendError) -> Status {
+    // Backend diagnostics may contain process paths or command data. Keep the
+    // control error categorical; a failure never supplies closure evidence.
+    match error {
+        BackendError::Denied(_) => Status::permission_denied("managed operation denied"),
+        BackendError::Unsupported(_) => Status::unimplemented("managed execution unavailable"),
+        BackendError::Descriptor(_) => Status::failed_precondition("managed identity invalid"),
+        _ => Status::unavailable("managed boundary unavailable"),
+    }
+}
+
+#[tonic::async_trait]
+impl p::managed_relay_server::ManagedRelay for Service {
+    async fn exchange(
+        &self,
+        request: Request<p::ManagedBoundaryRequest>,
+    ) -> Result<Response<p::ManagedBoundaryResponse>, Status> {
+        let request = request.into_inner();
+        if request.authority.as_ref() != Some(&self.authority) {
+            return Err(Status::permission_denied(
+                "managed relay authority mismatch",
+            ));
+        }
+        use p::managed_boundary_request::Operation;
+        use p::managed_boundary_response::Result as ResultValue;
+        let result = match request
+            .operation
+            .ok_or_else(|| Status::invalid_argument("managed operation missing"))?
+        {
+            Operation::Describe(_) => {
+                ResultValue::Runtime(self.client.describe().await.map_err(status)?)
+            }
+            Operation::Start(start) => {
+                ResultValue::Status(self.client.start(start).await.map_err(status)?)
+            }
+            Operation::Get(get) => ResultValue::Status(
+                self.client
+                    .get(identity(get.identity)?)
+                    .await
+                    .map_err(status)?,
+            ),
+            Operation::Cancel(cancel) => ResultValue::Status(
+                self.client
+                    .cancel(identity(cancel.identity)?, cancel.cancellation_request_id)
+                    .await
+                    .map_err(status)?,
+            ),
+            Operation::Read(read) => ResultValue::Output(
+                self.client
+                    .read(identity(read.identity)?, read.after_sequence, read.limit)
+                    .await
+                    .map_err(status)?,
+            ),
+        };
+        Ok(Response::new(p::ManagedBoundaryResponse {
+            result: Some(result),
+        }))
+    }
+}
+fn identity(value: Option<p::CommandIdentity>) -> Result<p::CommandIdentity, Status> {
+    value.ok_or_else(|| Status::invalid_argument("managed command identity missing"))
+}
+
+// A private memory stream has no caller-controlled peer metadata. Its authority
+// comes exclusively from the authenticated gateway RelayOpen control message.
+struct Stream(DuplexStream);
+impl tonic::transport::server::Connected for Stream {
+    type ConnectInfo = ();
+    fn connect_info(&self) {}
+}
+impl AsyncRead for Stream {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.0).poll_read(cx, buf)
+    }
+}
+impl AsyncWrite for Stream {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<std::io::Result<usize>> {
+        Pin::new(&mut self.0).poll_write(cx, buf)
+    }
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.0).poll_flush(cx)
+    }
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.0).poll_shutdown(cx)
+    }
+}
+
+pub(crate) fn open(
+    connector: &BoundaryLoopbackConnector,
+    authority: p::ManagedAuthority,
+) -> Result<DuplexStream, Box<dyn std::error::Error + Send + Sync>> {
+    let permit = RELAYS
+        .get_or_init(|| Arc::new(Semaphore::new(32)))
+        .clone()
+        .try_acquire_owned()
+        .map_err(|_| "managed relay capacity exceeded")?;
+    let client = connector
+        .managed(authority.clone())
+        .map_err(|_| "managed relay unavailable")?;
+    let service = p::managed_relay_server::ManagedRelayServer::new(Service { authority, client })
+        .max_decoding_message_size(MAX_MESSAGE)
+        .max_encoding_message_size(MAX_MESSAGE);
+    let (gateway, internal) = tokio::io::duplex(64 * 1024);
+    tokio::spawn(async move {
+        let _permit = permit;
+        let incoming = tokio_stream::once(Ok::<_, std::io::Error>(Stream(internal)));
+        let server = tonic::transport::Server::builder()
+            .concurrency_limit_per_connection(8)
+            .timeout(Duration::from_secs(10))
+            .add_service(service)
+            .serve_with_incoming(incoming);
+        // Losing the relay only loses observation. The boundary owns execution
+        // and durable status; this task must never infer command termination.
+        let _ = tokio::time::timeout(Duration::from_secs(30), server).await;
+    });
+    Ok(gateway)
+}
+
