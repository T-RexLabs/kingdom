+struct Activity(Arc<AtomicBool>);
+impl Drop for Activity {
+    fn drop(&mut self) {
+        self.0.store(false, Ordering::Release);
+    }
+}
+async fn output_pump(
+    mut output: BoundaryOutput,
+    stream: p::OutputStream,
+    writer: Arc<Mutex<Option<OutputWriter>>>,
+    failed: Arc<tokio::sync::Notify>,
+) -> Result<(), BackendError> {
+    let mut buffer = vec![0u8; checked::MAX_CHUNK_BYTES];
+    loop {
+        let count = match output.read(&mut buffer).await {
+            Ok(count) => count,
+            Err(error) => {
+                failed.notify_one();
+                return Err(unavailable(error));
+            }
+        };
+        if count == 0 {
+            return Ok(());
+        }
+        let data = buffer[..count].to_vec();
+        let writer = writer.clone();
+        let result = tokio::task::spawn_blocking(move || {
+            lock(&writer)?
+                .as_mut()
+                .ok_or_else(|| unavailable("managed output owner missing"))?
+                .append(stream, &data)
+                .map_err(unavailable)
+        })
+        .await
+        .map_err(unavailable)?;
+        if let Err(error) = result {
+            failed.notify_one();
+            return Err(error);
+        }
+    }
+}
+async fn run_command(
+    session: ExecSession,
+    stdin: Vec<u8>,
+    timeout: Option<Duration>,
+    writer: OutputWriter,
+    identity: p::CommandIdentity,
+    active: Arc<AtomicBool>,
+) {
+    let _activity = Activity(active);
+    let ExecSession {
+        process,
+        stdin: input,
+        stdout,
+        stderr,
+        ..
+    } = session;
+    let writer = Arc::new(Mutex::new(Some(writer)));
+    let failed = Arc::new(tokio::sync::Notify::new());
+    let mut out = tokio::spawn(output_pump(
+        stdout,
+        p::OutputStream::Stdout,
+        writer.clone(),
+        failed.clone(),
+    ));
+    let mut err = stderr.map(|stderr| {
+        tokio::spawn(output_pump(
+            stderr,
+            p::OutputStream::Stderr,
+            writer.clone(),
+            failed.clone(),
+        ))
+    });
+    let failed_input = failed.clone();
+    let mut input = tokio::spawn(async move {
+        let mut complete = stdin.is_empty();
+        if let Some(mut input) = input {
+            if input.write_all(&stdin).await.is_ok() {
+                complete = true;
+            } else {
+                failed_input.notify_one();
+            }
+            if input.shutdown().await.is_err() {
+                failed_input.notify_one();
+            }
+        } else if !complete {
+            failed_input.notify_one();
+        }
+        complete
+    });
+    let completion = process.managed_completion();
+    tokio::pin!(completion);
+    let deadline = async {
+        match timeout {
+            Some(timeout) => tokio::time::sleep(timeout).await,
+            None => std::future::pending().await,
+        }
+    };
+    let result = tokio::select! {
+        result = &mut completion => Some(result),
+        () = deadline => None,
+        () = failed.notified() => None,
+    };
+    let interrupted = result.is_none();
+    let result = match result {
+        Some(Err(error)) => {
+            let _ =
+                tokio::time::timeout(SIGNAL_TIMEOUT, process.signal(BoundarySignal::Kill)).await;
+            Err(error)
+        }
+        Some(Ok(facts)) => Ok(facts),
+        None => {
+            let _ =
+                tokio::time::timeout(SIGNAL_TIMEOUT, process.signal(BoundarySignal::Kill)).await;
+            match tokio::time::timeout(CLOSURE_TIMEOUT, &mut completion).await {
+                Ok(result) => result,
+                Err(_) => Err(unavailable("managed closure remains unresolved")),
+            }
+        }
+    };
+    let input_complete = matches!(
+        tokio::time::timeout(Duration::from_millis(200), &mut input).await,
+        Ok(Ok(true))
+    );
+    input.abort();
+    // Typed kernel closure and output EOF are independent. A blocked output
+    // persistence worker leaves the command unresolved; never race a receipt.
+    let output = tokio::time::timeout(OUTPUT_DRAIN_TIMEOUT, async {
+        let stdout = (&mut out).await.map_err(unavailable)?;
+        let stderr = match &mut err {
+            Some(err) => err.await.map_err(unavailable)?,
+            None => Ok(()),
+        };
+        Ok::<bool, BackendError>(stdout.is_ok() && stderr.is_ok())
+    })
+    .await;
+    out.abort();
+    if let Some(err) = err {
+        err.abort();
+    }
+    let (Ok(facts), Ok(Ok(output_eof))) = (result, output) else {
+        return;
+    };
+    let mut receipt = terminal(identity, facts);
+    receipt.input_complete = input_complete;
+    if interrupted {
+        receipt.termination_requested = true;
+        receipt.process_clean = false;
+    }
+    let _ = tokio::task::spawn_blocking(move || {
+        let writer = lock(&writer)?
+            .take()
+            .ok_or_else(|| unavailable("managed output owner missing"))?;
+        writer.complete(receipt, output_eof).map_err(unavailable)
+    })
+    .await;
+}
+fn terminal(identity: p::CommandIdentity, facts: ManagedCommandCompletion) -> p::TerminalReceipt {
+    let exit_status = Some(match facts.exit_status {
+        BoundaryExitStatus::Exited(code) => p::terminal_receipt::ExitStatus::ExitCode(code),
+        BoundaryExitStatus::Signaled(signal) => {
+            p::terminal_receipt::ExitStatus::Signal(signal as u32)
+        }
+    });
+    p::TerminalReceipt {
+        schema_version: 1,
+        identity: Some(identity),
+        exit_status,
+        group_closed: true,
+        termination_requested: facts.termination_requested,
+        forced_cleanup: facts.forced_cleanup,
+        process_clean: facts.is_clean(),
+        ..Default::default()
+    }
+}
