+use openshell_core::policy::SandboxPolicy;
+use openshell_isolation_interface::contract::{BackendError, ExecSpec};
+use std::path::{Component, Path, PathBuf};
+
+const PROJECT: &str = "/workspace/project";
+
+pub(super) struct PreparedPolicy {
+    pub policy: SandboxPolicy,
+    #[cfg(target_os = "linux")]
+    pub roots: Option<crate::sandbox::linux::PinnedToolRoots>,
+}
+pub(super) fn policy(
+    base: &SandboxPolicy,
+    spec: &ExecSpec,
+) -> Result<PreparedPolicy, BackendError> {
+    if !spec.project_tool {
+        return Ok(PreparedPolicy {
+            policy: base.clone(),
+            #[cfg(target_os = "linux")]
+            roots: None,
+        });
+    }
+    let cwd = spec
+        .workdir
+        .as_deref()
+        .ok_or_else(|| denied("project directory required"))?;
+    if spec.pty || spec.runtime_helper.is_some() || !spec.env.is_empty() {
+        return Err(denied(
+            "project tool cannot inherit helper, terminal or environment authority",
+        ));
+    }
+    let root = Path::new(PROJECT);
+    let directory = Path::new(cwd);
+    if !directory.starts_with(root)
+        || directory
+            .components()
+            .any(|c| matches!(c, Component::ParentDir | Component::CurDir))
+    {
+        return Err(denied("project tool directory is outside its project"));
+    }
+    #[cfg(target_os = "linux")]
+    let roots = crate::sandbox::linux::PinnedToolRoots::open()
+        .map_err(|_| denied("project tool roots unavailable"))?;
+    let root_info =
+        std::fs::symlink_metadata(root).map_err(|_| denied("project root unavailable"))?;
+    if !root_info.is_dir()
+        || std::fs::canonicalize(root).map_err(|_| denied("project root unavailable"))? != root
+    {
+        return Err(denied("project root must not traverse a symlink"));
+    }
+    let resolved =
+        std::fs::canonicalize(directory).map_err(|_| denied("project directory unavailable"))?;
+    if !resolved.starts_with(root) {
+        return Err(denied("project tool directory escapes through a symlink"));
+    }
+    Ok(PreparedPolicy {
+        policy: narrow(base)?,
+        #[cfg(target_os = "linux")]
+        roots: Some(roots),
+    })
+}
+
+fn denied(message: &str) -> BackendError {
+    BackendError::Denied(message.into())
+}
+
+// Intersect fixed tool access with the admitted sandbox policy. In particular,
+// an ancestor allowance for /workspace never reaches the derived policy.
+fn narrow(base: &SandboxPolicy) -> Result<SandboxPolicy, BackendError> {
+    let writable = |path: &Path| {
+        base.filesystem
+            .read_write
+            .iter()
+            .any(|allowed| path.starts_with(allowed))
+    };
+    let readable = |path: &Path| {
+        writable(path)
+            || base
+                .filesystem
+                .read_only
+                .iter()
+                .any(|allowed| path.starts_with(allowed))
+    };
+    if !writable(Path::new(PROJECT)) {
+        return Err(denied("sandbox does not grant project writes"));
+    }
+    let mut derived = base.clone();
+    derived.landlock.compatibility = openshell_core::policy::LandlockCompatibility::HardRequirement;
+    derived.filesystem.include_workdir = false;
+    derived.filesystem.read_only = ["/usr", "/bin", "/lib", "/lib64", "/etc", "/dev/urandom"]
+        .iter()
+        .map(PathBuf::from)
+        .filter(|path| readable(path))
+        .collect();
+    derived.filesystem.read_write = [PROJECT, "/tmp", "/dev/null"]
+        .iter()
+        .map(PathBuf::from)
+        .filter(|path| writable(path))
+        .collect();
+    Ok(derived)
+}
