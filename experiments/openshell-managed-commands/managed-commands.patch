+/// Only the admitted live owner receives a writer. Recovery never recreates it.
+/// On append failure the owner must terminate the command and retain unresolved
+/// state if terminal evidence cannot be persisted.
+pub struct OutputWriter {
+    store: Store,
+    identity: p::CommandIdentity,
+    output: File,
+    limit: u64,
+    bytes: u64,
+    sequence: u64,
+    failed: bool,
+    truncated: bool,
+}
+impl OutputWriter {
+    pub fn append(&mut self, stream: p::OutputStream, data: &[u8]) -> io::Result<()> {
+        if self.failed {
+            return Err(invalid("managed output writer already failed"));
+        }
+        if data.is_empty()
+            || data.len() > MAX_CHUNK_BYTES
+            || self.bytes + data.len() as u64 > self.limit
+            || self.sequence >= MAX_OUTPUT_CHUNKS
+        {
+            self.failed = true;
+            self.truncated = true;
+            return Err(invalid("managed output retention exhausted"));
+        }
+        let chunk = p::OutputChunk {
+            sequence: self.sequence + 1,
+            stream: stream.into(),
+            data: data.to_vec(),
+        };
+        validate_output_chunk(&chunk, self.sequence + 1).map_err(invalid)?;
+        let bytes = chunk.encode_to_vec();
+        let result = (|| {
+            let _guard = lock(&self.store.0.serial)?;
+            self.output.write_all(&(bytes.len() as u32).to_be_bytes())?;
+            self.output.write_all(&bytes)?;
+            self.output.sync_all()
+        })();
+        if result.is_err() {
+            self.failed = true;
+        }
+        result?;
+        self.sequence += 1;
+        self.bytes += data.len() as u64;
+        Ok(())
+    }
+    /// Supply only trusted typed kernel closure facts. This function does not
+    /// infer closure from stdout EOF, raw exit zero, or caller assertions.
+    pub fn complete(
+        self,
+        mut receipt: p::TerminalReceipt,
+        output_eof: bool,
+    ) -> io::Result<p::TerminalReceipt> {
+        let _guard = lock(&self.store.0.serial)?;
+        if receipt.identity.as_ref() != Some(&self.identity) {
+            return Err(invalid("terminal identity mismatch"));
+        }
+        let mut manifest = self.store.scan_locked(&self.identity, |_, _| Ok(()))?;
+        manifest.complete = output_eof && !self.failed;
+        manifest.gap = self.failed && !self.truncated;
+        manifest.truncated = self.truncated;
+        match read_message::<p::ManagedCancel>(&self.store.path(&self.identity, "cancel")?) {
+            Ok(cancel) if cancel.identity.as_ref() == Some(&self.identity) => {
+                receipt.termination_requested = true;
+                receipt.process_clean = false;
+            }
+            Ok(_) => return Err(invalid("cancellation identity mismatch")),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error),
+        }
+        receipt.output = Some(manifest);
+        receipt.receipt_sha256 =
+            crate::kingdom_managed::receipt_digest(&receipt).map_err(invalid)?;
+        validate_receipt(&receipt, &self.identity).map_err(invalid)?;
+        persist(&self.store.path(&self.identity, "terminal")?, &receipt)?;
+        Ok(receipt)
+    }
+}
