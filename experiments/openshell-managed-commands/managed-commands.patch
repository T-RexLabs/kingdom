+mod tests {
+    use super::*;
+    #[test]
+    fn backend_errors_never_disclose_diagnostics() {
+        for error in [
+            BackendError::Denied("secret".into()),
+            BackendError::Unsupported("secret".into()),
+            BackendError::Descriptor("secret".into()),
+            BackendError::Process("secret".into()),
+        ] {
+            assert!(!status(error).message().contains("secret"));
+        }
+    }
+    #[test]
+    fn operations_require_retained_identity() {
+        assert!(identity(None).is_err());
+    }
+}
