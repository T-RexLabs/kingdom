+#[derive(Clone)]
+struct ManagedGrpcRouter<N, M> {
+    openshell: N,
+    managed: M,
+}
+impl<N, M, B> tower::Service<Request<B>> for ManagedGrpcRouter<N, M>
+where
+    N: tower::Service<Request<B>> + Clone + Send + 'static,
+    N::Response: Send,
+    N::Future: Send,
+    N::Error: Send,
+    M: tower::Service<Request<B>, Response = N::Response, Error = N::Error>
+        + Clone
+        + Send
+        + 'static,
+    M::Future: Send,
+    B: Send + 'static,
+{
+    type Response = N::Response;
+    type Error = N::Error;
+    type Future = Pin<Box<dyn Future<Output = Result<Self::Response, Self::Error>> + Send>>;
+    fn poll_ready(&mut self, _cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        Poll::Ready(Ok(()))
+    }
+    fn call(&mut self, req: Request<B>) -> Self::Future {
+        if req
+            .uri()
+            .path()
+            .starts_with("/kingdom.openshell.managed.v1.ManagedExecutions/")
+        {
+            let mut svc = self.managed.clone();
+            Box::pin(async move { svc.ready().await?.call(req).await })
+        } else {
+            let mut svc = self.openshell.clone();
+            Box::pin(async move { svc.ready().await?.call(req).await })
+        }
+    }
+}
