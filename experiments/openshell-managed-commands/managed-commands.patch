+// SPDX-License-Identifier: Apache-2.0
+
+//! Experimental command-group closure. Not a durable execution protocol.
+//! The leader enters this operation terminal but unreaped. All
+//! workload members must have the managed seccomp profile, which prevents
+//! changing process groups or sessions after trusted pre-exec assignment.
+
+use nix::sys::signal::{Signal, killpg};
+use nix::unistd::Pid;
+use std::io;
+use std::time::{Duration, Instant};
+
+pub(crate) fn enabled() -> bool {
+    cfg!(feature = "kingdom-managed-commands")
+}
+
+/// Reap one terminal leader and all descendants in its immutable group.
+/// The caller must hold its signal lock and must have observed leader terminal
+/// with WNOWAIT. The registry lock blocks other trusted group launches and the
+/// orphan reaper until ECHILD proves closure. Workloads cannot change groups.
+pub(crate) fn reap_and_close_group(
+    child: &mut std::process::Child,
+) -> io::Result<std::process::ExitStatus> {
+    use nix::sys::wait::{WaitPidFlag, WaitStatus, waitpid};
+    let group = child.id();
+    let group_pid = i32::try_from(group)
+        .ok()
+        .filter(|pid| *pid > 0)
+        .ok_or_else(|| io::Error::other("invalid managed process group"))?;
+    let owns_namespace = std::process::id() == 1;
+    // Unit tests use an isolated subreaper child. Production requires PID 1:
+    // an ordinary subreaper cannot exclude external group creators.
+    #[cfg(test)]
+    let owns_namespace = owns_namespace || rustix::process::child_subreaper()?.is_some();
+    if !owns_namespace {
+        let _ = killpg(Pid::from_raw(group_pid), Signal::SIGKILL);
+        let _ = child.wait();
+        return Err(io::Error::other(
+            "managed closure requires exclusive PID 1 ownership",
+        ));
+    }
+    let _registry = crate::managed_children::lock();
+    let status = child.wait()?;
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let mut forced = false;
+    loop {
+        // __WALL includes clone children with non-SIGCHLD termination signals.
+        match waitpid(
+            Pid::from_raw(-group_pid),
+            Some(WaitPidFlag::WNOHANG | WaitPidFlag::__WALL),
+        ) {
+            Err(nix::errno::Errno::ECHILD) => {
+                return if forced {
+                    Err(io::Error::other(
+                        "managed command left live descendants; forced cleanup completed",
+                    ))
+                } else {
+                    Ok(status)
+                };
+            }
+            Ok(WaitStatus::StillAlive) => {
+                forced = true;
+                killpg(Pid::from_raw(group_pid), Signal::SIGKILL).map_err(io::Error::other)?;
+                if Instant::now() >= deadline {
+                    return Err(io::Error::other(
+                        "managed command closure was not proved before deadline",
+                    ));
+                }
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            Ok(WaitStatus::Exited(..) | WaitStatus::Signaled(..)) => {}
+            Err(nix::errno::Errno::EINTR) => {}
+            Err(error) => return Err(io::Error::other(error)),
+            Ok(_) => return Err(io::Error::other("unexpected managed child wait state")),
+        }
+    }
+}
