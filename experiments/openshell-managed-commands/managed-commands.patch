+    #[test]
+    fn managed_store_cancel_identity_cannot_retarget_and_zero_stays_nonclean() {
+        let fixture = Fixture::new();
+        let store = fixture.store();
+        let first = start(1024);
+        let second = start(1024);
+        let active = writer(&store, &first);
+        drop(writer(&store, &second));
+        let mut cancel = p::ManagedCancel {
+            identity: first.identity.clone(),
+            cancellation_request_id: uuid::Uuid::new_v4().to_string(),
