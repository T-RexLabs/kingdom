+    assert!(require_created_image(&expected, Some(&expected)).is_ok());
+    assert!(require_created_image(&expected, Some(&different)).is_err());
+    assert!(require_created_image(&expected, None).is_err());
+    assert!(require_created_image("image:latest", Some("image:latest")).is_err());
+}
