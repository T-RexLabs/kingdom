+// SPDX-License-Identifier: Apache-2.0
+//! Checked identities and receipts for the opt-in managed execution extension.
+//! Validation cannot substitute for authentication or a trusted deployment pin.
+
+use openshell_core::proto::extension::v1::PeerMetadata;
+use openshell_core::proto::kingdom_managed as p;
+use openshell_isolation_interface::contract::BackendError;
+use prost::Message;
+
+pub const CAPABILITY: &str = "openshell.kingdom.managed-execution.v2";
+pub const START_METHOD: &str = "/kingdom.openshell.managed.v1.ManagedExecutions/StartExecution";
+pub const MAX_OUTPUT_BYTES: u64 = 16 * 1024 * 1024;
+pub const MAX_CHUNK_BYTES: usize = 64 * 1024;
+pub const MAX_OUTPUT_CHUNKS: u64 = 4096;
+pub const MAX_OUTPUT_BATCH_BYTES: usize = 512 * 1024;
+pub const MAX_CONTROL_BYTES: usize = 1024 * 1024;
+// Leave room for gateway authority, durable identity, and protocol envelopes.
+pub const MAX_COMMAND_BYTES: usize = MAX_CONTROL_BYTES - 16 * 1024;
+
+fn invalid(message: &str) -> BackendError {
+    BackendError::Denied(message.into())
+}
+fn identifier(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 256 && !value.contains('\0')
+}
+fn uuid(value: &str) -> bool {
+    uuid::Uuid::parse_str(value).is_ok_and(|id| !id.is_nil() && id.to_string() == value)
+}
+fn hash(value: &impl Message) -> Result<Vec<u8>, BackendError> {
+    openshell_crypto::sha256(&value.encode_to_vec())
+        .map(|digest| digest.to_vec())
+        .map_err(|_| BackendError::Unavailable("managed digest unavailable".into()))
+}
+
+pub fn require_capability(peer: &PeerMetadata) -> Result<(), BackendError> {
+    if !peer
+        .supported_capabilities
+        .iter()
+        .any(|value| value == CAPABILITY)
+    {
+        return Err(BackendError::Unsupported(
+            "managed execution capability is absent".into(),
+        ));
+    }
+    Ok(())
+}
+
+pub fn validate_runtime(value: &p::RuntimeBinding) -> Result<(), BackendError> {
+    if !identifier(&value.sandbox_id)
+        || !identifier(&value.boundary_generation)
+        || !identifier(&value.main_process_instance_id)
+        || value.deployment_profile_sha256.len() != 32
+    {
+        return Err(invalid("invalid managed runtime binding"));
+    }
+    Ok(())
+}
+
+pub fn validate_start(value: &p::StartExecutionRequest) -> Result<(), BackendError> {
+    if value.encoded_len() > MAX_COMMAND_BYTES {
+        return Err(invalid("managed command exceeds control limit"));
+    }
+    let selector = value
+        .execution
+        .as_ref()
+        .ok_or_else(|| invalid("managed execution selector missing"))?;
+    validate_selector(selector)?;
+    let command = value
+        .command
+        .as_ref()
+        .ok_or_else(|| invalid("managed command missing"))?;
+    match p::CommandScope::try_from(command.scope) {
+        Ok(p::CommandScope::Sandbox) => {}
+        Ok(p::CommandScope::ProjectTool) => {
+            if !command.environment.is_empty()
+                || !(command.workdir == "/workspace/project"
+                    || command.workdir.starts_with("/workspace/project/"))
+                || command.workdir[1..]
+                    .split('/')
+                    .any(|part| part.is_empty() || part == "." || part == "..")
+            {
+                return Err(invalid("invalid project tool scope"));
+            }
+        }
+        Err(_) => return Err(invalid("unknown managed command scope")),
+    }
+    if command.argv.is_empty()
+        || command.argv.len() > 4096
+        || command.argv[0].is_empty()
+        || command.argv.iter().any(|arg| arg.contains('\0'))
+        || !command.workdir.starts_with('/')
+        || command.workdir.len() > 4096
+        || command.workdir.contains('\0')
+        || command.output_limit_bytes == 0
+        || command.output_limit_bytes > MAX_OUTPUT_BYTES
+    {
+        return Err(invalid("invalid managed command limits or paths"));
+    }
+    if command.environment.len() > 256
+        || command
+            .environment
+            .iter()
+            .map(|(key, value)| key.len() + value.len())
+            .sum::<usize>()
+            > 64 * 1024
+    {
+        return Err(invalid("managed environment exceeds limit"));
+    }
+    for (key, value) in &command.environment {
+        let mut bytes = key.bytes();
+        let valid_name = bytes
+            .next()
+            .is_some_and(|byte| byte.is_ascii_alphabetic() || byte == b'_')
+            && bytes.all(|byte| byte.is_ascii_alphanumeric() || byte == b'_');
+        if !valid_name || key.starts_with("OPENSHELL_") || value.contains('\0') {
+            return Err(invalid("invalid managed command environment"));
+        }
+    }
+    if let Some(timeout) = &command.execution_timeout {
+        if timeout.seconds < 0
+            || !(0..1_000_000_000).contains(&timeout.nanos)
+            || (timeout.seconds == 0 && timeout.nanos == 0)
+        {
+            return Err(invalid("invalid managed execution timeout"));
+        }
+    }
+    Ok(())
+}
+
+pub fn validate_selector(value: &p::ExecutionSelector) -> Result<(), BackendError> {
+    if !identifier(&value.workspace) || !identifier(&value.sandbox) || !uuid(&value.request_id) {
+        return Err(invalid("invalid managed execution selector"));
+    }
+    validate_runtime(
+        value
+            .runtime
+            .as_ref()
+            .ok_or_else(|| invalid("managed runtime binding missing"))?,
+    )
+}
+
+/// Trusted values obtained from authorization and the authenticated runtime
+/// session. Never construct this from public request metadata or body fields.
+pub struct AuthorizedOwner<'a> {
+    pub gateway_id: &'a str,
+    pub workspace_id: &'a str,
+    pub subject_id: &'a str,
+    pub runtime: &'a p::RuntimeBinding,
+}
+
+pub fn bind_start(
+    request: &p::StartExecutionRequest,
+    effective: &p::CommandSpec,
+    owner: &AuthorizedOwner<'_>,
+    boundary_request_id: &str,
+) -> Result<p::CommandIdentity, BackendError> {
+    validate_start(request)?;
+    validate_runtime(owner.runtime)?;
+    let selector = request.execution.as_ref().expect("validated selector");
+    if selector.runtime.as_ref() != Some(owner.runtime)
+        || !identifier(owner.gateway_id)
+        || !identifier(owner.workspace_id)
+        || !identifier(owner.subject_id)
+        || !uuid(boundary_request_id)
+    {
+        return Err(invalid(
+            "managed execution owner does not match admitted runtime",
+        ));
+    }
+    // Translation is trusted, but cannot silently remove bounds or produce an
+    // invalid executable specification.
+    let mut effective_request = request.clone();
+    effective_request.command = Some(effective.clone());
+    validate_start(&effective_request)?;
+    Ok(p::CommandIdentity {
+        schema_version: 1,
+        gateway_id: owner.gateway_id.into(),
+        workspace_id: owner.workspace_id.into(),
+        subject_id: owner.subject_id.into(),
+        method: START_METHOD.into(),
+        request_id: selector.request_id.clone(),
+        original_request_sha256: hash(request)?,
+        effective_spec_sha256: hash(effective)?,
+        boundary_request_id: boundary_request_id.into(),
+        runtime: Some(owner.runtime.clone()),
+    })
+}
+
+/// Recheck immediately inside admission against the actual authenticated owner.
+/// A matching profile string alone never establishes runtime identity.
+pub fn validate_admission(
+    identity: &p::CommandIdentity,
+    effective: &p::CommandSpec,
+    owner: &AuthorizedOwner<'_>,
+) -> Result<(), BackendError> {
+    if identity.schema_version != 1
+        || identity.method != START_METHOD
+        || !identifier(owner.gateway_id)
+        || !identifier(owner.workspace_id)
+        || !identifier(owner.subject_id)
+        || identity.gateway_id != owner.gateway_id
+        || identity.workspace_id != owner.workspace_id
+        || identity.subject_id != owner.subject_id
+        || identity.runtime.as_ref() != Some(owner.runtime)
+        || !uuid(&identity.request_id)
+        || !uuid(&identity.boundary_request_id)
+        || identity.original_request_sha256.len() != 32
+        || identity.effective_spec_sha256 != hash(effective)?
+    {
+        return Err(invalid("managed admission identity or payload mismatch"));
+    }
+    validate_start(&p::StartExecutionRequest {
+        execution: Some(p::ExecutionSelector {
+            workspace: owner.workspace_id.into(),
+            sandbox: owner.runtime.sandbox_id.clone(),
+            request_id: identity.request_id.clone(),
+            runtime: Some(owner.runtime.clone()),
+        }),
+        command: Some(effective.clone()),
+    })
+}
+
+/// The retained identity is authoritative. Any difference, including original
+/// request content that translates to the same effective argv, rejects replay.
+pub fn validate_replay(
+    retained: &p::CommandIdentity,
+    proposed: &p::CommandIdentity,
+) -> Result<(), BackendError> {
+    if retained != proposed {
+        return Err(invalid(
+            "managed request identity was reused with different ownership or content",
+        ));
+    }
+    Ok(())
+}
+
+pub fn validate_read(value: &p::ReadOutputRequest) -> Result<(), BackendError> {
+    validate_selector(
+        value
+            .execution
+            .as_ref()
+            .ok_or_else(|| invalid("managed selector missing"))?,
+    )?;
+    if value.limit == 0 || value.limit > 256 || value.after_sequence == u64::MAX {
+        return Err(invalid("invalid managed output cursor or limit"));
+    }
+    Ok(())
+}
+
+pub fn receipt_digest(value: &p::TerminalReceipt) -> Result<Vec<u8>, BackendError> {
+    let mut canonical = value.clone();
+    canonical.receipt_sha256.clear();
+    hash(&canonical)
+}
+
+pub fn validate_receipt(
+    value: &p::TerminalReceipt,
+    identity: &p::CommandIdentity,
+) -> Result<(), BackendError> {
+    use p::terminal_receipt::ExitStatus;
+    let valid_exit = matches!(
+        value.exit_status,
+        Some(ExitStatus::ExitCode(0..=255)) | Some(ExitStatus::Signal(1..=64))
+    );
+    if value.schema_version != 1
+        || value.identity.as_ref() != Some(identity)
+        || !value.group_closed
+        || !valid_exit
+        || value.process_clean != (!value.termination_requested && !value.forced_cleanup)
+        || value.receipt_sha256 != receipt_digest(value)?
+    {
+        return Err(invalid("invalid managed terminal receipt"));
+    }
+    let output = value
+        .output
+        .as_ref()
+        .ok_or_else(|| invalid("managed output manifest missing"))?;
+    let empty_digest = openshell_crypto::sha256(&[])
+        .map_err(|_| BackendError::Unavailable("managed digest unavailable".into()))?;
+    if output.sha256.len() != 32
+        || output.total_bytes > MAX_OUTPUT_BYTES
+        || (output.total_bytes == 0 && output.sha256.as_slice() != empty_digest.as_slice())
+        || (output.total_bytes == 0) != (output.last_sequence == 0)
+        || output.last_sequence > output.total_bytes
+        || output.last_sequence > MAX_OUTPUT_CHUNKS
+        || (output.complete && (output.gap || output.truncated))
+    {
+        return Err(invalid("invalid managed output manifest"));
+    }
+    Ok(())
+}
+
+pub fn validate_output_chunk(
+    value: &p::OutputChunk,
+    expected_sequence: u64,
+) -> Result<(), BackendError> {
+    if expected_sequence == 0
+        || value.sequence != expected_sequence
+        || !matches!(
+            p::OutputStream::try_from(value.stream),
+            Ok(p::OutputStream::Stdout | p::OutputStream::Stderr)
+        )
+        || value.data.is_empty()
+        || value.data.len() > MAX_CHUNK_BYTES
+    {
+        return Err(invalid("managed output sequence or chunk is invalid"));
+    }
+    Ok(())
+}
+
+/// Check the authenticated gateway context before accepting any operation,
+/// including Describe. The transport supplies the expected session identities.
+pub fn validate_authority(
+    value: &p::ManagedAuthority,
+    gateway_id: &str,
+    sandbox_id: &str,
+    generation: &str,
+) -> Result<(), BackendError> {
+    if !identifier(&value.gateway_id)
+        || !identifier(&value.workspace_id)
+        || !identifier(&value.subject_id)
+        || value.gateway_id != gateway_id
+        || value.sandbox_id != sandbox_id
+        || value.boundary_generation != generation
+        || !identifier(sandbox_id)
+        || !identifier(generation)
+    {
+        return Err(invalid(
+            "managed authority does not match the authenticated boundary session",
+        ));
+    }
+    Ok(())
+}
+
+pub fn validate_output_batch(
+    value: &p::ManagedOutputBatch,
+    after_sequence: u64,
+) -> Result<(), BackendError> {
+    if value.encoded_len() > MAX_OUTPUT_BATCH_BYTES
+        || value.durable_output_sequence > MAX_OUTPUT_CHUNKS
+    {
+        return Err(invalid("managed output batch exceeds retention limits"));
+    }
+    let mut expected = after_sequence
+        .checked_add(1)
+        .ok_or_else(|| invalid("managed output cursor overflow"))?;
+    for chunk in &value.chunks {
+        validate_output_chunk(chunk, expected)?;
+        if chunk.sequence > value.durable_output_sequence {
+            return Err(invalid("managed output exceeds durable watermark"));
+        }
+        expected = expected
+            .checked_add(1)
+            .ok_or_else(|| invalid("managed output cursor overflow"))?;
+    }
+    if value.next_sequence != expected || after_sequence > value.durable_output_sequence {
+        return Err(invalid("managed output batch skips a retained sequence"));
+    }
+    // Empty reads may only occur at the watermark. Otherwise a missing chunk
+    // could be silently hidden by returning no data and an unchanged cursor.
+    if value.chunks.is_empty() && after_sequence < value.durable_output_sequence {
+        return Err(invalid("managed output batch hides retained output"));
+    }
+    Ok(())
+}
+
