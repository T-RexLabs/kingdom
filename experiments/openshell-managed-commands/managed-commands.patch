+// SPDX-License-Identifier: Apache-2.0
+//! One-way runtime admission and evidence retention. Only a verified durable
+//! archive can release native lifecycle operations; records are never deleted.
+use super::*;
+use openshell_core::proto::kingdom_managed::{ManagedAuthority, RuntimeArchive, RuntimeBinding};
+use prost::Message;
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeSet;
+
+const RETENTION_TYPE: &str = "KingdomManagedRuntimeRetentionV1";
+pub(crate) const ARCHIVE_TYPE: &str = "KingdomManagedRuntimeArchiveV1";
+const MARKER: &str = "kingdom.openshell/managed-retention";
+pub(crate) const ARCHIVE_DOMAIN: &[u8] = b"kingdom.openshell.runtime-archive.v1\0";
+fn retention_id(id: &str) -> String {
+    format!("kingdom-managed-runtime:{id}")
+}
+pub(crate) fn archive_record_id(id: &str) -> String {
+    format!("kingdom-managed-archive:{id}")
+}
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+pub(crate) enum Phase {
+    Active,
+    Finalizing,
+    Released,
+}
+#[derive(Clone, Serialize, Deserialize)]
+pub(crate) struct Retention {
+    pub binding: Vec<u8>,
+    pub gateway_id: String,
+    pub workspace_id: String,
+    pub subject_id: String,
+    pub workspace_name: String,
+    pub sandbox_name: String,
+    pub commands: BTreeSet<String>,
+    pub phase: Phase,
+    pub archive_id: Option<String>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+pub(crate) struct StoredArchive {
+    pub proof: Vec<u8>,
+    pub workspace_name: String,
+    pub sandbox_name: String,
+}
+pub(crate) struct AdmissionGuard {
+    _gate: SandboxLifecycleGuard,
+    _local: LocalMutationGuard,
+    _distributed: crate::persistence::DistributedMutationGuard,
+}
+fn bad() -> Status {
+    Status::data_loss("managed retention is inconsistent")
+}
+pub(crate) fn verify_archive(value: &RuntimeArchive) -> Result<(), Status> {
+    let manifest = value.manifest.as_ref().ok_or_else(bad)?;
+    if manifest.schema_version != 2
+        || manifest.commands.len() > 64
+        || manifest.gateway_id.is_empty()
+        || manifest.workspace_id.is_empty()
+        || manifest.subject_id.is_empty()
+    {
+        return Err(bad());
+    }
+    let binding = manifest.runtime.as_ref().ok_or_else(bad)?;
+    openshell_sandbox_backend::kingdom_managed::validate_runtime(binding).map_err(|_| bad())?;
+    let mut previous = "";
+    for command in &manifest.commands {
+        let identity = command.identity.as_ref().ok_or_else(bad)?;
+        if identity.runtime.as_ref() != Some(binding)
+            || identity.gateway_id != manifest.gateway_id
+            || identity.workspace_id != manifest.workspace_id
+            || identity.subject_id != manifest.subject_id
+            || identity.boundary_request_id.as_str() <= previous
+            || command.receipt_sha256.len() != 32
+            || command.output.is_none()
+        {
+            return Err(bad());
+        }
+        previous = &identity.boundary_request_id;
+    }
+    let mut bytes = ARCHIVE_DOMAIN.to_vec();
+    bytes.extend(manifest.encode_to_vec());
+    let digest = openshell_crypto::sha256(&bytes).map_err(|_| bad())?;
+    if value.manifest_sha256 != digest || value.archive_id != hex::encode(digest) {
+        return Err(bad());
+    }
+    Ok(())
+}
+pub(crate) async fn read_archive(store: &Store, id: &str) -> Result<StoredArchive, Status> {
+    if id.len() != 64
+        || !id
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    {
+        return Err(Status::invalid_argument("invalid archive identifier"));
+    }
+    let row = store
+        .get(ARCHIVE_TYPE, &archive_record_id(id))
+        .await
+        .map_err(|_| Status::unavailable("archive unavailable"))?
+        .ok_or_else(|| Status::not_found("archive not found"))?;
+    let archive: StoredArchive = serde_json::from_slice(&row.payload).map_err(|_| bad())?;
+    let proof = RuntimeArchive::decode(archive.proof.as_slice()).map_err(|_| bad())?;
+    verify_archive(&proof)?;
+    if proof.archive_id != id {
+        return Err(bad());
+    }
+    Ok(archive)
+}
+pub(crate) async fn read_retention(
+    store: &Store,
+    id: &str,
+) -> Result<Option<(Retention, u64)>, Status> {
+    store
+        .get(RETENTION_TYPE, &retention_id(id))
+        .await
+        .map_err(|_| Status::unavailable("managed retention unavailable"))?
+        .map(|row| {
+            Ok((
+                serde_json::from_slice(&row.payload).map_err(|_| bad())?,
+                row.resource_version,
+            ))
+        })
+        .transpose()
+}
+pub(super) async fn lock_driver_boundary(
+    store: &Store,
+    id: &str,
+) -> Result<crate::persistence::DistributedMutationGuard, Status> {
+    store
+        .acquire_distributed_mutation_guard(
+            &crate::persistence::MutationLockSet::sandbox_lifecycle(id),
+            tokio::time::Instant::now() + Duration::from_secs(10),
+        )
+        .await
+        .map_err(|_| Status::unavailable("managed lifecycle lock unavailable"))
+}
+pub(super) async fn ensure_released(store: &Store, id: &str) -> Result<(), Status> {
+    if let Some((record, _)) = read_retention(store, id).await? {
+        if record.phase != Phase::Released {
+            return Err(Status::failed_precondition(
+                "managed runtime requires verified archival before lifecycle changes",
+            ));
+        }
+        let archive = read_archive(store, record.archive_id.as_deref().ok_or_else(bad)?).await?;
+        let proof = RuntimeArchive::decode(archive.proof.as_slice()).map_err(|_| bad())?;
+        if proof
+            .manifest
+            .as_ref()
+            .and_then(|m| m.runtime.as_ref())
+            .map(Message::encode_to_vec)
+            != Some(record.binding)
+        {
+            return Err(bad());
+        }
+    }
+    Ok(())
+}
+impl ComputeRuntime {
+    async fn managed_guard(&self, id: &str) -> Result<AdmissionGuard, Status> {
+        let gate = self.lifecycle_gates.lock_for(id).await;
+        let local = self.lock_sandbox_for_lifecycle(&gate).await;
+        let distributed = lock_driver_boundary(&self.store, id).await?;
+        Ok(AdmissionGuard {
+            _gate: gate,
+            _local: local,
+            _distributed: distributed,
+        })
+    }
+    pub(crate) async fn retain_managed_runtime(
