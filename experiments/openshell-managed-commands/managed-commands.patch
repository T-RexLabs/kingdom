+//! Descriptor-pinned mutable roots for the fixed project tool scope.
+use miette::{IntoDiagnostic, Result};
+use rustix::fs::{Mode, OFlags, fstat, open, openat};
+use std::os::fd::OwnedFd;
+use std::path::{Component, Path};
+
+pub struct PinnedToolRoots {
+    project: OwnedFd,
+    temporary: OwnedFd,
+}
+fn directory(path: &Path) -> Result<OwnedFd> {
+    let flags = OFlags::PATH | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::CLOEXEC;
+    let mut fd = open("/", flags, Mode::empty()).into_diagnostic()?;
+    for component in path.components() {
+        match component {
+            Component::RootDir => (),
+            Component::Normal(name) => {
+                fd = openat(&fd, name, flags, Mode::empty()).into_diagnostic()?
+            }
+            _ => return Err(miette::miette!("noncanonical project tool root")),
+        }
+    }
+    Ok(fd)
+}
+impl PinnedToolRoots {
+    pub fn open() -> Result<Self> {
+        let roots = Self {
+            project: directory(Path::new("/workspace/project"))?,
+            temporary: directory(Path::new("/tmp"))?,
+        };
+        // The workload may write temporary entries, but must not own the root
+        // or its parent and replace the allowance with another hierarchy.
+        let root = directory(Path::new("/"))?;
+        let root_stat = fstat(&root).into_diagnostic()?;
+        let tmp_stat = fstat(&roots.temporary).into_diagnostic()?;
+        if root_stat.st_uid != 0 || root_stat.st_mode & 0o022 != 0 || tmp_stat.st_uid != 0 {
+            return Err(miette::miette!(
+                "project tool requires immutable system roots"
+            ));
+        }
+        roots.verify()?;
+        Ok(roots)
+    }
+    pub(super) fn fd(&self, path: &Path) -> Option<&OwnedFd> {
+        match path.to_str()? {
+            "/workspace/project" => Some(&self.project),
+            "/tmp" => Some(&self.temporary),
+            _ => None,
+        }
+    }
+    pub fn verify(&self) -> Result<()> {
+        for (path, fd) in [
+            ("/workspace/project", &self.project),
+            ("/tmp", &self.temporary),
+        ] {
+            let current = directory(Path::new(path))?;
+            let original = fstat(fd).into_diagnostic()?;
+            let observed = fstat(&current).into_diagnostic()?;
+            if original.st_dev != observed.st_dev || original.st_ino != observed.st_ino {
+                return Err(miette::miette!(
+                    "project tool root changed during preparation"
+                ));
+            }
+        }
+        Ok(())
+    }
+}
