+// SPDX-License-Identifier: Apache-2.0
+//! Experimental durable admission tombstones. Never replay an admitted launch.
+//! This directory must be provisioned outside all workload write grants. It is
+//! retained across boundary restarts, not claimed to survive sandbox deletion.
+use serde::{Deserialize, Serialize};
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Write};
+use std::os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt};
+use std::path::{Path, PathBuf};
+
+pub const ROOT: &str = "/.openshell/channel/sandbox/kingdom-exec-journal";
+pub fn enabled() -> bool {
+    crate::kingdom_managed::enabled()
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Intent {
+    pub request_id: String,
+    pub payload_digest: String,
+    pub sandbox_id: String,
+    pub generation: String,
+    pub process_id: String,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Terminal {
+    pub schema_version: u32,
+    pub clean: bool,
+    pub termination_requested: bool,
+    pub forced_cleanup: bool,
+    pub intent: Intent,
+    pub exit_code: Option<i32>,
+    pub signal: Option<i32>,
+    pub group_closed: bool,
+}
+#[derive(Debug)]
+pub struct Lease {
+    root: PathBuf,
+    key: String,
+    pub intent: Intent,
+}
+#[derive(Debug)]
+pub enum Admission {
+    New(Lease),
+    Existing(Option<Terminal>),
+}
+
+pub fn validate_root(root: &Path) -> io::Result<()> {
+    let owner = nix::unistd::geteuid().as_raw();
+    for ancestor in root.ancestors().skip(1) {
+        let meta = fs::symlink_metadata(ancestor)?;
+        if !meta.is_dir() || (meta.uid() != 0 && meta.uid() != owner) || meta.mode() & 0o022 != 0 {
+            return Err(io::Error::other(
+                "journal ancestors must be trusted non-writable directories without symlinks",
+            ));
+        }
+    }
+    match fs::DirBuilder::new().mode(0o700).create(root) {
+        Ok(()) => File::open(
+            root.parent()
+                .ok_or_else(|| io::Error::other("missing parent"))?,
+        )?
+        .sync_all()?,
+        Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+        Err(error) => return Err(error),
+    }
+    let meta = fs::symlink_metadata(root)?;
+    if !meta.is_dir() || meta.uid() != owner || meta.mode() & 0o777 != 0o700 {
+        return Err(io::Error::other(
+            "journal must be a private directory owned by boundary UID",
+        ));
+    }
+    Ok(())
+}
+
+pub fn validate_policy(
+    policy: &openshell_sandbox_backend::boundary_protocol::SandboxPolicyWire,
+) -> io::Result<()> {
+    use openshell_sandbox_backend::boundary_protocol::LandlockCompatibilityWire;
+    if policy.include_workdir
+        || !matches!(policy.landlock, LandlockCompatibilityWire::HardRequirement)
+    {
+        return Err(io::Error::other(
+            "managed journal requires hard Landlock and explicit workdir grants",
+        ));
+    }
+    let root = Path::new(ROOT);
+    validate_root(root)?;
+    for path in &policy.read_write {
+        let canonical = path.canonicalize()?;
+        if root.starts_with(&canonical) || canonical.starts_with(root) {
+            return Err(io::Error::other(
+                "workload write grant overlaps trusted journal",
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn persist(path: &Path, value: &impl Serialize) -> io::Result<()> {
+    let bytes = serde_json::to_vec(value)?;
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)?;
+    file.write_all(&bytes)?;
+    file.sync_all()?;
+    File::open(
+        path.parent()
+            .ok_or_else(|| io::Error::other("missing parent"))?,
+    )?
+    .sync_all()
+}
+fn read<T: serde::de::DeserializeOwned>(path: &Path) -> io::Result<T> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK)
+        .open(path)?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file()
+        || metadata.len() > 64 * 1024
+        || metadata.uid() != nix::unistd::geteuid().as_raw()
+        || metadata.mode() & 0o077 != 0
+        || metadata.nlink() != 1
+    {
+        return Err(io::Error::other("invalid journal record"));
+    }
+    Ok(serde_json::from_reader(file)?)
+}
+
+pub fn reserve(root: &Path, intent: Intent) -> io::Result<Admission> {
+    // A digest is used only as a safe filename; the full identity is compared.
+    let key = hex::encode(
+        openshell_crypto::sha256(intent.request_id.as_bytes()).map_err(io::Error::other)?,
+    );
+    let path = root.join(format!("{key}.intent.json"));
+    match persist(&path, &intent) {
+        Ok(()) => Ok(Admission::New(Lease {
+            root: root.into(),
+            key,
+            intent,
+        })),
+        Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
+            let prior: Intent = read(&path)?;
+            if prior.request_id != intent.request_id
+                || prior.payload_digest != intent.payload_digest
+                || prior.sandbox_id != intent.sandbox_id
+                || prior.generation != intent.generation
+            {
+                return Err(io::Error::other(
+                    "durable request identity or payload conflict",
+                ));
+            }
+            let terminal = match read::<Terminal>(&root.join(format!("{key}.terminal.json"))) {
+                Ok(value) if value.intent == prior && value.valid() => Some(value),
+                Ok(_) => return Err(io::Error::other("invalid terminal binding")),
+                Err(error) if error.kind() == io::ErrorKind::NotFound => None,
+                Err(error) => return Err(error),
+            };
+            Ok(Admission::Existing(terminal))
+        }
+        Err(error) => Err(error),
+    }
+}
+impl Terminal {
+    fn valid(&self) -> bool {
+        self.schema_version == 2
+            && self.group_closed
+            && self.exit_code.is_some() != self.signal.is_some()
+            && self.clean == (!self.termination_requested && !self.forced_cleanup)
+    }
+}
+impl Lease {
+    pub fn complete(self, facts: crate::native_api::ManagedCommandCompletion) -> io::Result<()> {
+        use openshell_isolation_interface::contract::BoundaryExitStatus;
+        let (exit_code, signal) = match facts.exit_status {
+            BoundaryExitStatus::Exited(code) => (Some(code), None),
+            BoundaryExitStatus::Signaled(signal) => (None, Some(signal)),
+        };
+        let terminal = Terminal {
+            schema_version: 2,
+            clean: facts.is_clean(),
+            termination_requested: facts.termination_requested,
+            forced_cleanup: facts.forced_cleanup,
+            intent: self.intent,
+            exit_code,
+            signal,
+            group_closed: true,
+        };
+        if !terminal.valid() {
+            return Err(io::Error::other("invalid managed terminal facts"));
+        }
+        persist(
+            &self.root.join(format!("{}.terminal.json", self.key)),
+            &terminal,
+        )
+    }
+}
