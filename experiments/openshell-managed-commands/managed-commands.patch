+                .put_if(
+                    RETENTION_TYPE,
+                    &retention_id(&binding.sandbox_id),
+                    &binding.sandbox_id,
+                    "",
+                    &serde_json::to_vec(&record).map_err(|_| bad())?,
+                    None,
+                    WriteCondition::MatchResourceVersion(version),
+                )
+                .await
+                .map_err(|_| Status::aborted("managed finalization changed concurrently"))?;
+        }
+        Ok(record)
+    }
