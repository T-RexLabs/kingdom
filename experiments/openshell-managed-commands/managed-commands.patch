@@ -0,0 +1,2096 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Opt-in managed execution RPCs. Durable intent precedes transport; only the
+//! authenticated boundary's retained receipt can establish process closure.
+use crate::auth::workspace_authz::MinWorkspaceRole;
+use crate::auth::{
+    identity::IdentityProvider, principal::Principal, sandbox_session::PersistedSandboxIdentity,
+};
+use crate::{
+    ServerState,
+    persistence::{ObjectRecord, WriteCondition},
+};
+use openshell_core::proto::{ManagedRelayTarget, Workspace, kingdom_managed as p, relay_open};
+use openshell_sandbox_backend::kingdom_managed as checked;
+use prost::Message;
+use serde::{Deserialize, Serialize};
+use std::{pin::Pin, sync::Arc, time::Duration};
+use tonic::{Request, Response, Status};
+
+#[path = "managed_archive.rs"]
+pub(crate) mod archive;
+#[path = "managed_delete.rs"]
+mod deletion;
+
+const RECORD_TYPE: &str = "KingdomManagedExecutionV1";
+const CANCEL_TYPE: &str = "KingdomManagedCancellationV1";
+const DEADLINE: Duration = Duration::from_secs(10);
+
+#[derive(Clone)]
+pub struct ManagedService {
+    state: Arc<ServerState>,
+    archive_slots: Arc<tokio::sync::Semaphore>,
+}
+impl ManagedService {
+    pub fn new(state: Arc<ServerState>) -> Self {
+        let archive_slots = state.managed_archive_slots.clone();
+        Self {
+            state,
+            archive_slots,
+        }
+    }
+}
+
+// Store outside workspace-owned objects: deleting a workspace must not erase
+// an uncertain dispatch or permit reuse of its request identifier.
+#[derive(Serialize, Deserialize)]
+struct Retained {
+    original: Vec<u8>,
+    effective: Vec<u8>,
+    identity: Vec<u8>,
+    status: Vec<u8>,
+}
+struct Authorized {
+    authority: p::ManagedAuthority,
+    runtime: p::RuntimeBinding,
+    terminating: bool,
+}
+
+fn invalid(_: impl std::fmt::Display) -> Status {
+    Status::invalid_argument("invalid managed execution")
+}
+fn unavailable(_: impl std::fmt::Display) -> Status {
+    Status::unavailable("managed execution state unavailable")
+}
+fn corrupt() -> Status {
+    Status::data_loss("managed execution record is inconsistent")
+}
+fn key(parts: &[&str]) -> Result<String, Status> {
+    let encoded = serde_json::to_vec(parts).map_err(unavailable)?;
+    Ok(hex::encode(
+        openshell_crypto::sha256(&encoded).map_err(unavailable)?,
+    ))
+}
+fn identity(retained: &Retained) -> Result<p::CommandIdentity, Status> {
+    p::CommandIdentity::decode(retained.identity.as_slice()).map_err(|_| corrupt())
+}
+fn decode(record: &ObjectRecord) -> Result<Retained, Status> {
+    serde_json::from_slice(&record.payload).map_err(|_| corrupt())
+}
+fn status(retained: &Retained) -> Result<p::ExecutionStatus, Status> {
+    p::ExecutionStatus::decode(retained.status.as_slice()).map_err(|_| corrupt())
+}
+
+impl ManagedService {
+    fn subject(&self, principal: &Principal) -> Result<String, Status> {
+        let user = principal.user_identity().ok_or_else(|| {
+            Status::permission_denied("managed execution requires user authentication")
+        })?;
+        if user.provider == IdentityProvider::LocalDev {
+            return Err(Status::unauthenticated(
+                "managed execution requires verified authentication",
+            ));
+        }
+        let subject = match principal {
+            Principal::Operator(operator) => {
+                key(&["operator", &operator.certificate_sha256, &user.subject])?
+            }
+            Principal::User(_) => {
+                let provider = format!("{:?}", user.provider);
+                let issuer = self
+                    .state
+                    .config
+                    .oidc
+                    .as_ref()
+                    .map_or("", |config| config.issuer.as_str());
+                key(&[&provider, issuer, &user.subject])?
+            }
+            _ => {
+                return Err(Status::permission_denied(
+                    "managed execution requires user authentication",
+                ));
+            }
+        };
+        Ok(subject)
+    }
+    async fn authorize(
+        &self,
+        principal: &Principal,
+        workspace: &str,
+        sandbox: &str,
+    ) -> Result<Authorized, Status> {
+        let subject = self.subject(principal)?;
+        let sb = super::sandbox::resolve_and_authorize_sandbox_name(
+            &self.state,
+            principal,
+            sandbox,
+            workspace,
+            MinWorkspaceRole::User,
+        )
+        .await?;
+        let metadata = sb.metadata.as_ref().ok_or_else(corrupt)?;
+        if metadata.deletion_time.is_some() {
+            return Err(Status::failed_precondition("sandbox is being deleted"));
+        }
+        let persisted = PersistedSandboxIdentity::read(&metadata.annotations).map_err(|_| {
+            Status::failed_precondition("sandbox has no authenticated runtime generation")
+        })?;
+        let ws = self
+            .state
+            .store
+            .get_message_by_name::<Workspace>("", workspace)
+            .await
+            .map_err(unavailable)?
+            .ok_or_else(|| Status::not_found("workspace not found"))?;
+        let wm = ws.metadata.as_ref().ok_or_else(corrupt)?;
+        let terminating = wm.deletion_time.is_some();
+        let gateway = self.state.config.gateway_jwt.as_ref().ok_or_else(|| {
+            Status::failed_precondition("managed runtime requires gateway identity")
+        })?;
+        let authority = p::ManagedAuthority {
+            gateway_id: gateway.gateway_id.clone(),
+            workspace_id: wm.id.clone(),
+            subject_id: subject,
+            sandbox_id: metadata.id.clone(),
+            boundary_generation: persisted.runtime_generation.to_string(),
+        };
+        let reply = self
+            .exchange(
+                &authority,
+                p::managed_boundary_request::Operation::Describe(p::ManagedDescribe {}),
+            )
+            .await?;
+        let Some(p::managed_boundary_response::Result::Runtime(runtime)) = reply.result else {
+            return Err(corrupt());
+        };
+        if runtime.capability != checked::CAPABILITY
+            || runtime.maximum_output_bytes != checked::MAX_OUTPUT_BYTES
+            || runtime.gateway_id != authority.gateway_id
+            || runtime.workspace_id != authority.workspace_id
+            || runtime.subject_id != authority.subject_id
+        {
+            return Err(Status::failed_precondition(
+                "managed runtime capability is unavailable",
+            ));
+        }
+        let binding = runtime.runtime.ok_or_else(corrupt)?;
+        checked::validate_runtime(&binding).map_err(|_| corrupt())?;
+        if binding.sandbox_id != authority.sandbox_id
+            || binding.boundary_generation != authority.boundary_generation
+        {
+            return Err(Status::failed_precondition(
+                "managed runtime generation changed",
+            ));
+        }
+        Ok(Authorized {
+            authority,
+            runtime: binding,
+            terminating,
+        })
+    }
+
+    async fn exchange(
+        &self,
+        authority: &p::ManagedAuthority,
+        operation: p::managed_boundary_request::Operation,
+    ) -> Result<p::ManagedBoundaryResponse, Status> {
+        let request = p::ManagedBoundaryRequest {
+            authority: Some(authority.clone()),
+            operation: Some(operation),
+        };
+        if request.encoded_len() > checked::MAX_CONTROL_BYTES {
+            return Err(invalid("control limit"));
+        }
+        let target = relay_open::Target::Managed(ManagedRelayTarget {
+            authority: Some(authority.clone()),
+        });
+        let work = async {
+            let (_, claimed) = crate::supervisor_session::open_routed_relay_with_target(
+                &self.state,
+                &authority.sandbox_id,
+                target,
+                String::new(),
+                DEADLINE,
+            )
+            .await?;
+            let stream = claimed.await.map_err(unavailable)??;
+            let stream = Arc::new(std::sync::Mutex::new(Some(stream)));
+            let channel =
+                tonic::transport::Endpoint::from_static("http://managed-boundary.invalid")
+                    .connect_timeout(DEADLINE)
+                    .timeout(DEADLINE)
+                    .connect_with_connector(tower::service_fn(move |_| {
+                        let stream = stream.lock().expect("managed relay lock").take();
+                        async move {
+                            stream.map(hyper_util::rt::TokioIo::new).ok_or_else(|| {
+                                std::io::Error::other("managed relay cannot reconnect")
+                            })
+                        }
+                    }))
+                    .await
+                    .map_err(unavailable)?;
+            let mut client = p::managed_relay_client::ManagedRelayClient::new(channel)
+                .max_decoding_message_size(checked::MAX_CONTROL_BYTES)
+                .max_encoding_message_size(checked::MAX_CONTROL_BYTES);
+            client.exchange(request).await.map(Response::into_inner)
+        };
+        tokio::time::timeout(DEADLINE, work)
+            .await
+            .map_err(|_| Status::deadline_exceeded("managed relay outcome is unknown"))?
+    }
+
+    async fn retained(
+        &self,
+        selector: &p::ExecutionSelector,
+        owner: &Authorized,
+    ) -> Result<(String, ObjectRecord, Retained), Status> {
+        checked::validate_selector(selector).map_err(invalid)?;
+        if selector.runtime.as_ref() != Some(&owner.runtime) {
+            return Err(Status::failed_precondition(
+                "managed runtime binding changed",
+            ));
+        }
+        let id = key(&[
+            &owner.authority.gateway_id,
+            &owner.authority.workspace_id,
+            &owner.authority.subject_id,
+            &selector.request_id,
+        ])?;
+        let record = self
+            .state
+            .store
+            .get(RECORD_TYPE, &id)
+            .await
+            .map_err(unavailable)?
+            .ok_or_else(|| Status::not_found("managed execution not found"))?;
+        let retained = decode(&record)?;
+        let identity = identity(&retained)?;
+        let effective =
+            p::CommandSpec::decode(retained.effective.as_slice()).map_err(|_| corrupt())?;
+        checked::validate_admission(&identity, &effective, &owner.checked())
+            .map_err(|_| Status::permission_denied("managed execution owner mismatch"))?;
+        let original = p::StartExecutionRequest::decode(retained.original.as_slice())
+            .map_err(|_| corrupt())?;
+        let rebound = checked::bind_start(
+            &original,
+            &effective,
+            &owner.checked(),
+            &identity.boundary_request_id,
+        )
+        .map_err(|_| corrupt())?;
+        checked::validate_replay(&identity, &rebound).map_err(|_| corrupt())?;
+        if identity.request_id != selector.request_id {
+            return Err(corrupt());
+        }
+        Ok((id, record, retained))
+    }
+
+    async fn save_status(
+        &self,
+        id: &str,
+        candidate: p::ExecutionStatus,
+    ) -> Result<p::ExecutionStatus, Status> {
+        for _ in 0..8 {
+            let record = self
+                .state
+                .store
+                .get(RECORD_TYPE, id)
+                .await
+                .map_err(unavailable)?
+                .ok_or_else(corrupt)?;
+            let mut retained = decode(&record)?;
+            validate_status(&candidate, &identity(&retained)?)?;
+            let old = status(&retained)?;
+            if old.terminal.is_some() {
+                if candidate.terminal.is_some() && candidate.terminal != old.terminal {
+                    return Err(corrupt());
+                }
+                return Ok(old);
+            }
+            if candidate.durable_output_sequence < old.durable_output_sequence {
+                return Ok(old);
+            }
+            retained.status = candidate.encode_to_vec();
+            let bytes = serde_json::to_vec(&retained).map_err(unavailable)?;
+            match self
+                .state
+                .store
+                .put_if(
+                    RECORD_TYPE,
+                    id,
+                    id,
+                    "",
+                    &bytes,
+                    None,
+                    WriteCondition::MatchResourceVersion(record.resource_version),
+                )
+                .await
+            {
+                Ok(_) => return Ok(candidate),
+                Err(crate::persistence::PersistenceError::Conflict { .. }) => continue,
+                Err(error) => return Err(unavailable(error)),
+            }
+        }
+        Err(Status::aborted("managed execution changed concurrently"))
+    }
+
+    async fn refresh(
+        &self,
+        id: &str,
+        retained: &Retained,
+        owner: &Authorized,
+    ) -> Result<p::ExecutionStatus, Status> {
+        let reply = self
+            .exchange(
+                &owner.authority,
+                p::managed_boundary_request::Operation::Get(p::ManagedGet {
+                    identity: Some(identity(retained)?),
+                }),
+            )
+            .await;
+        match reply {
+            Ok(p::ManagedBoundaryResponse {
+                result: Some(p::managed_boundary_response::Result::Status(value)),
+            }) => self.save_status(id, value).await,
+            Ok(_) => Err(corrupt()),
+            Err(_) => Ok(status(retained)?), // retained uncertainty is not closure
+        }
+    }
+}
+impl Authorized {
+    fn checked(&self) -> checked::AuthorizedOwner<'_> {
+        checked::AuthorizedOwner {
+            gateway_id: &self.authority.gateway_id,
+            workspace_id: &self.authority.workspace_id,
+            subject_id: &self.authority.subject_id,
+            runtime: &self.runtime,
+        }
+    }
+}
+fn validate_status(
+    value: &p::ExecutionStatus,
+    identity: &p::CommandIdentity,
+) -> Result<(), Status> {
+    if value.identity.as_ref() != Some(identity)
+        || value.durable_output_sequence > checked::MAX_OUTPUT_CHUNKS
+    {
+        return Err(corrupt());
+    }
+    match p::ExecutionState::try_from(value.state) {
+        Ok(p::ExecutionState::Closed) => {
+            let receipt = value.terminal.as_ref().ok_or_else(corrupt)?;
+            checked::validate_receipt(receipt, identity).map_err(|_| corrupt())?;
+            if receipt.output.as_ref().ok_or_else(corrupt)?.last_sequence
+                != value.durable_output_sequence
+            {
+                return Err(corrupt());
+            }
+        }
+        Ok(
+            p::ExecutionState::Admitted
+            | p::ExecutionState::Running
+            | p::ExecutionState::Unresolved,
+        ) if value.terminal.is_none() => {}
+        _ => return Err(corrupt()),
+    }
+    Ok(())
+}
