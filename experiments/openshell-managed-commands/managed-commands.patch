+    async fn archive_one(
+        &self,
+        id: &str,
+        runtime: &retention::Retention,
+    ) -> Result<Retained, Status> {
+        let record = self
+            .state
+            .store
+            .get(RECORD_TYPE, id)
+            .await
+            .map_err(unavailable)?
+            .ok_or_else(|| {
+                Status::failed_precondition("managed admission evidence remains unresolved")
+            })?;
+        let retained = decode(&record)?;
