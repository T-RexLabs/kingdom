+    }
+    pub(super) async fn archived_request(
+        &self,
+        principal: &Principal,
+        request: &p::ArchivedExecutionRequest,
+    ) -> Result<Retained, Status> {
+        let archive = retention::read_archive(&self.state.store, &request.archive_id).await?;
+        let proof = p::RuntimeArchive::decode(archive.proof.as_slice()).map_err(|_| corrupt())?;
+        let manifest = proof.manifest.as_ref().ok_or_else(corrupt)?;
+        let subject = self
+            .archive_authorize(
+                principal,
+                &archive.workspace_name,
+                &manifest.workspace_id,
+                &manifest.gateway_id,
+                MinWorkspaceRole::User,
+            )
+            .await?;
+        let entry = manifest
+            .commands
+            .iter()
+            .find(|entry| {
+                entry
+                    .identity
+                    .as_ref()
+                    .is_some_and(|i| i.subject_id == subject && i.request_id == request.request_id)
+            })
+            .ok_or_else(|| Status::not_found("archived execution not found"))?;
+        let identity = entry.identity.as_ref().ok_or_else(corrupt)?;
+        let record = self
+            .state
+            .store
+            .get(COMMAND_ARCHIVE_TYPE, &command_key(&record_id(identity)?))
+            .await
+            .map_err(unavailable)?
+            .ok_or_else(corrupt)?;
+        let retained = decode(&record)?;
+        let receipt = closed(&retained)?;
+        if receipt.identity.as_ref() != Some(identity)
+            || receipt.receipt_sha256 != entry.receipt_sha256
+            || receipt.output != entry.output
+        {
+            return Err(corrupt());
+        }
+        Ok(retained)
+    }
+    pub(super) async fn archived_selector(
+        &self,
+        principal: &Principal,
+        selector: &p::ExecutionSelector,
+    ) -> Result<Option<(Retained, Authorized)>, Status> {
+        checked::validate_selector(selector).map_err(invalid)?;
+        let binding = selector.runtime.as_ref().ok_or_else(corrupt)?;
+        let Some((record, _)) =
+            retention::read_retention(&self.state.store, &binding.sandbox_id).await?
+        else {
+            return Ok(None);
+        };
+        if record.phase != retention::Phase::Released {
+            return Ok(None);
+        }
+        if record.binding != binding.encode_to_vec()
+            || record.workspace_name != selector.workspace
+            || record.sandbox_name != selector.sandbox
+        {
+            return Err(Status::failed_precondition(
+                "archived runtime identity changed",
+            ));
+        }
+        let retained = self
+            .archived_request(
+                principal,
+                &p::ArchivedExecutionRequest {
+                    archive_id: record.archive_id.ok_or_else(corrupt)?,
+                    request_id: selector.request_id.clone(),
+                },
+            )
+            .await?;
+        let identity = identity(&retained)?;
+        let owner = Authorized {
+            authority: p::ManagedAuthority {
+                gateway_id: identity.gateway_id,
+                workspace_id: identity.workspace_id,
+                subject_id: identity.subject_id,
+                sandbox_id: binding.sandbox_id.clone(),
+                boundary_generation: binding.boundary_generation.clone(),
+            },
+            runtime: binding.clone(),
+            terminating: true,
+        };
+        Ok(Some((retained, owner)))
+    }
+    pub(super) async fn archived_chunks(
+        &self,
+        retained: &Retained,
+        after: u64,
+        limit: u32,
+    ) -> Result<Vec<p::OutputChunk>, Status> {
+        if limit == 0 || limit > 64 {
+            return Err(invalid("output limit"));
+        }
+        let receipt = closed(retained)?;
+        let output = receipt.output.as_ref().ok_or_else(corrupt)?;
+        if after > output.last_sequence {
+            return Err(invalid("output cursor"));
+        }
+        let id = record_id(&identity(retained)?)?;
+        let mut chunks = Vec::new();
+        let mut size = 0;
+        for sequence in after + 1
+            ..=output
+                .last_sequence
+                .min(after.saturating_add(u64::from(limit)))
+        {
+            let row = self
+                .state
+                .store
+                .get(CHUNK_TYPE, &chunk_key(&id, sequence))
+                .await
+                .map_err(unavailable)?
+                .ok_or_else(corrupt)?;
+            let chunk = p::OutputChunk::decode(row.payload.as_slice()).map_err(|_| corrupt())?;
+            if chunk.sequence != sequence || chunk.data.len() > checked::MAX_CHUNK_BYTES {
+                return Err(corrupt());
+            }
+            size += row.payload.len();
+            if size > checked::MAX_OUTPUT_BATCH_BYTES {
+                break;
+            }
+            chunks.push(chunk);
+        }
+        checked::validate_output_batch(
+            &p::ManagedOutputBatch {
+                chunks: chunks.clone(),
+                next_sequence: chunks.last().map_or(after + 1, |c| c.sequence + 1),
+                durable_output_sequence: output.last_sequence,
+            },
+            after,
+        )
+        .map_err(|_| corrupt())?;
+        Ok(chunks)
+    }
+}
