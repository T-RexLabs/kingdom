+// SPDX-License-Identifier: Apache-2.0
+
+//! Experimental command-group closure. Not a durable execution protocol.
+//! The leader enters this operation terminal but unreaped. All
+//! workload members must have the managed seccomp profile, which prevents
+//! changing process groups or sessions after trusted pre-exec assignment.
+
+use nix::sys::signal::{Signal, killpg};
+use nix::unistd::Pid;
+use std::io;
+use std::time::{Duration, Instant};
+
+pub(crate) fn enabled() -> bool {
+    cfg!(feature = "kingdom-managed-commands")
+}
+
+#[derive(Debug)]
+pub(crate) struct GroupCompletion {
+    pub status: std::process::ExitStatus,
+    pub forced_cleanup: bool,
+}
+
+/// Reap one terminal leader and all descendants in its immutable group.
+/// The caller must hold its signal lock and must have observed leader terminal
+/// with WNOWAIT. The registry lock blocks other trusted group launches and the
+/// orphan reaper until ECHILD proves closure. Workloads cannot change groups.
+pub(crate) fn reap_and_close_group(child: &mut std::process::Child) -> io::Result<GroupCompletion> {
+    use nix::sys::wait::{WaitPidFlag, WaitStatus, waitpid};
+    let group = child.id();
+    let group_pid = i32::try_from(group)
+        .ok()
+        .filter(|pid| *pid > 0)
+        .ok_or_else(|| io::Error::other("invalid managed process group"))?;
+    let owns_namespace = std::process::id() == 1;
+    // Unit tests use an isolated subreaper child. Production requires PID 1:
+    // an ordinary subreaper cannot exclude external group creators.
+    #[cfg(test)]
+    let owns_namespace = owns_namespace || rustix::process::child_subreaper()?.is_some();
+    if !owns_namespace {
+        let _ = killpg(Pid::from_raw(group_pid), Signal::SIGKILL);
+        let _ = child.wait();
+        return Err(io::Error::other(
+            "managed closure requires exclusive PID 1 ownership",
+        ));
+    }
+    let _registry = crate::managed_children::lock();
+    let status = child.wait()?;
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let mut forced = false;
+    loop {
+        // __WALL includes clone children with non-SIGCHLD termination signals.
+        match waitpid(
+            Pid::from_raw(-group_pid),
+            Some(WaitPidFlag::WNOHANG | WaitPidFlag::__WALL),
+        ) {
+            Err(nix::errno::Errno::ECHILD) => {
+                return Ok(GroupCompletion {
+                    status,
+                    forced_cleanup: forced,
+                });
+            }
+            Ok(WaitStatus::StillAlive) => {
+                forced = true;
+                killpg(Pid::from_raw(group_pid), Signal::SIGKILL).map_err(io::Error::other)?;
+                if Instant::now() >= deadline {
+                    return Err(io::Error::other(
+                        "managed command closure was not proved before deadline",
+                    ));
+                }
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            Ok(WaitStatus::Exited(..) | WaitStatus::Signaled(..)) => {}
+            Err(nix::errno::Errno::EINTR) => {}
+            Err(error) => return Err(io::Error::other(error)),
+            Ok(_) => return Err(io::Error::other("unexpected managed child wait state")),
+        }
+    }
+}
+
+#[cfg(test)]
+pub(crate) fn isolated_subreaper(test: &str) -> bool {
+    const HELPER: &str = "KINGDOM_SUBREAPER_TEST";
+    if std::env::var(HELPER).as_deref() == Ok(test) {
+        rustix::process::set_child_subreaper(Some(rustix::process::getpid())).unwrap();
+        return true;
+    }
+    let output = std::process::Command::new(std::env::current_exe().unwrap())
+        .args(["--exact", test, "--nocapture"])
+        .env(HELPER, test)
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "{} {}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    false
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::process::CommandExt;
+    use std::process::{Command, Stdio};
+
+    fn child(script: &str) -> std::process::Child {
+        let mut command = Command::new("/bin/sh");
+        command
+            .args(["-c", script])
+            .stdout(Stdio::null())
+            .stderr(Stdio::null());
+        command.process_group(0);
+        command.spawn().expect("spawn group leader")
+    }
+
+    #[test]
+    fn natural_exit_closes_without_cleanup() {
+        if !isolated_subreaper("kingdom_managed::tests::natural_exit_closes_without_cleanup") {
+            return;
+        }
+        let mut leader = child("exit 0");
+        crate::managed_children::wait_until_terminal(leader.id()).unwrap();
+        reap_and_close_group(&mut leader).unwrap();
+        assert!(leader.wait().unwrap().success());
+    }
+
+    #[test]
+    fn surviving_child_is_killed_and_not_reported_as_success() {
+        if !isolated_subreaper(
+            "kingdom_managed::tests::surviving_child_is_killed_and_not_reported_as_success",
+        ) {
+            return;
+        }
+        let mut sibling = child("sleep 60");
+        let mut leader = child("sleep 60 & exit 0");
+        crate::managed_children::wait_until_terminal(leader.id()).unwrap();
+        let result = reap_and_close_group(&mut leader);
+        assert!(result.unwrap().forced_cleanup);
+        assert!(
+            sibling.try_wait().unwrap().is_none(),
+            "unrelated sibling must remain alive"
+        );
+        leader.wait().unwrap();
+        killpg(
+            Pid::from_raw(i32::try_from(sibling.id()).unwrap()),
+            Signal::SIGKILL,
+        )
+        .unwrap();
+        sibling.wait().unwrap();
+    }
+
+    #[test]
+    fn cancellation_closes_the_group_without_touching_a_sibling() {
+        if !isolated_subreaper(
+            "kingdom_managed::tests::cancellation_closes_the_group_without_touching_a_sibling",
+        ) {
+            return;
+        }
+        let mut sibling = child("sleep 60");
+        let mut leader = child("sleep 60 & wait");
+        killpg(
+            Pid::from_raw(i32::try_from(leader.id()).unwrap()),
+            Signal::SIGKILL,
+        )
+        .unwrap();
+        crate::managed_children::wait_until_terminal(leader.id()).unwrap();
+        // Closure remains proven whether cancellation needed additional cleanup.
+        reap_and_close_group(&mut leader).unwrap();
+        assert!(sibling.try_wait().unwrap().is_none());
+        leader.wait().unwrap();
+        killpg(
+            Pid::from_raw(i32::try_from(sibling.id()).unwrap()),
+            Signal::SIGKILL,
+        )
+        .unwrap();
+        sibling.wait().unwrap();
+    }
+
+    #[test]
+    fn double_fork_churn_cannot_evade_kernel_child_wait() {
+        if !isolated_subreaper(
+            "kingdom_managed::tests::double_fork_churn_cannot_evade_kernel_child_wait",
+        ) {
+            return;
+        }
+        let mut leader =
+            child("i=0; while [ $i -lt 64 ]; do (sleep 60 &) & i=$((i+1)); done; exit 0");
+        crate::managed_children::wait_until_terminal(leader.id()).unwrap();
+        assert!(reap_and_close_group(&mut leader).unwrap().forced_cleanup);
+        use nix::sys::wait::{WaitPidFlag, waitpid};
+        assert_eq!(
+            waitpid(
+                Pid::from_raw(-i32::try_from(leader.id()).unwrap()),
+                Some(WaitPidFlag::WNOHANG | WaitPidFlag::__WALL)
+            ),
+            Err(nix::errno::Errno::ECHILD)
+        );
+    }
+
+    #[test]
+    #[allow(unsafe_code)]
+    fn managed_filter_denies_group_and_session_escape() {
+        const CHILD: &str = "KINGDOM_MANAGED_FILTER_TEST_CHILD";
+        if std::env::var_os(CHILD).is_some() {
+            let mut program = crate::linux::child_seccomp::prepare_with_managed_groups(
+                std::process::id() + 1,
+                true,
+            )
+            .unwrap();
+            program.install().unwrap();
+            assert_eq!(unsafe { libc::setpgid(0, 0) }, -1);
+            assert_eq!(io::Error::last_os_error().raw_os_error(), Some(libc::EPERM));
+            assert_eq!(unsafe { libc::setsid() }, -1);
+            assert_eq!(io::Error::last_os_error().raw_os_error(), Some(libc::EPERM));
+            return;
+        }
+        let output = Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "kingdom_managed::tests::managed_filter_denies_group_and_session_escape",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stdout)
+        );
+    }
+}
