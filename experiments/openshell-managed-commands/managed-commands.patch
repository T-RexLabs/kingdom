+// SPDX-License-Identifier: Apache-2.0
+//! Durable command owner behind the authenticated SandboxProtocol extension.
+use crate::native_api::{BoundaryExec, BoundaryProcess, ExecSession, ManagedCommandCompletion};
+use openshell_core::proto::kingdom_managed as p;
+use openshell_isolation_interface::contract::{
+    BackendError, BoundaryExitStatus, BoundaryOutput, BoundarySignal, ExecSpec,
+};
+use openshell_sandbox_backend::kingdom_managed as checked;
+use openshell_sandbox_backend::kingdom_managed_store::{Admission, OutputWriter, Store};
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+pub(crate) fn validate_private_reads(
+    read_only: &[std::path::PathBuf],
+    journal: &std::path::Path,
+) -> std::io::Result<()> {
+    for path in read_only {
+        let canonical = path.canonicalize()?;
+        if journal.starts_with(&canonical) || canonical.starts_with(journal) {
+            return Err(std::io::Error::other(
+                "workload read grant overlaps private managed records",
+            ));
+        }
+    }
+    Ok(())
+}
+
+const SIGNAL_TIMEOUT: Duration = Duration::from_secs(2);
+const CLOSURE_TIMEOUT: Duration = Duration::from_secs(8);
+const OUTPUT_DRAIN_TIMEOUT: Duration = Duration::from_secs(2);
+
+fn unavailable(error: impl ToString) -> BackendError {
+    BackendError::Unavailable(error.to_string())
+}
+fn lock<T>(value: &Mutex<T>) -> Result<std::sync::MutexGuard<'_, T>, BackendError> {
+    value
+        .lock()
+        .map_err(|_| unavailable("managed owner lock poisoned"))
+}
+fn command_key(identity: &p::CommandIdentity) -> String {
+    format!("{}\0{}", identity.workspace_id, identity.request_id)
+}
+struct LiveCommand {
+    process: Arc<dyn BoundaryProcess>,
+    active: Arc<AtomicBool>,
+}
+pub(crate) struct ManagedOwner {
+    store: Store,
+    live: Mutex<HashMap<String, LiveCommand>>,
+}
+impl ManagedOwner {
+    pub(crate) fn new(store: Store) -> Self {
+        Self {
+            store,
+            live: Mutex::new(HashMap::new()),
+        }
+    }
+    /// Called while boundary admission holds the current connection and main
+    /// generation locks. The runtime binding is measured by that boundary.
+    pub(crate) fn dispatch(
+        &self,
+        request: p::ManagedBoundaryRequest,
+        runtime: &p::RuntimeBinding,
+        executor: Arc<dyn BoundaryExec>,
+        handle: &tokio::runtime::Handle,
+    ) -> Result<p::ManagedBoundaryResponse, BackendError> {
+        use p::managed_boundary_request::Operation;
+        use p::managed_boundary_response::Result as ResultValue;
+        let authority = request
+            .authority
+            .as_ref()
+            .ok_or_else(|| BackendError::Denied("managed authority missing".into()))?;
+        let result = match request
+            .operation
+            .ok_or_else(|| BackendError::Denied("managed operation missing".into()))?
+        {
+            Operation::Describe(_) => ResultValue::Runtime(p::DescribeRuntimeResponse {
+                runtime: Some(runtime.clone()),
+                capability: checked::CAPABILITY.into(),
+                maximum_output_bytes: checked::MAX_OUTPUT_BYTES,
+                gateway_id: authority.gateway_id.clone(),
+                workspace_id: authority.workspace_id.clone(),
+                subject_id: authority.subject_id.clone(),
+            }),
+            Operation::Start(start) => {
+                let identity = start
+                    .identity
+                    .as_ref()
+                    .ok_or_else(|| BackendError::Denied("managed identity missing".into()))?;
+                let spec = start
+                    .effective_spec
+                    .as_ref()
+                    .ok_or_else(|| BackendError::Denied("managed spec missing".into()))?;
+                let owner = checked::AuthorizedOwner {
+                    gateway_id: &authority.gateway_id,
+                    workspace_id: &authority.workspace_id,
+                    subject_id: &authority.subject_id,
+                    runtime,
+                };
+                checked::validate_admission(identity, spec, &owner)?;
+                ResultValue::Status(self.start(start, executor, handle)?)
+            }
+            Operation::Get(get) => {
+                let identity = self.authorize_identity(get.identity, authority, runtime)?;
+                ResultValue::Status(self.get(&identity)?)
+            }
+            Operation::Cancel(cancel) => {
+                let identity =
+                    self.authorize_identity(cancel.identity.clone(), authority, runtime)?;
+                if self.store.cancel(&cancel).map_err(unavailable)? {
+                    if let Some(command) = lock(&self.live)?.get(&command_key(&identity)) {
+                        {
+                            // Even after observation fails, the retained process object owns the signal lock;
+                            // no recovered numeric PID is ever signaled.
+                            handle
+                                .block_on(async {
+                                    tokio::time::timeout(
+                                        SIGNAL_TIMEOUT,
+                                        command.process.signal(BoundarySignal::Kill),
+                                    )
+                                    .await
+                                })
+                                .map_err(unavailable)??;
+                        }
+                    }
+                }
+                ResultValue::Status(self.get(&identity)?)
+            }
+            Operation::Read(read) => {
+                let identity = self.authorize_identity(read.identity, authority, runtime)?;
+                ResultValue::Output(
+                    self.store
+                        .read(&identity, read.after_sequence, read.limit)
+                        .map_err(unavailable)?,
+                )
+            }
+        };
+        Ok(p::ManagedBoundaryResponse {
+            result: Some(result),
+        })
+    }
+    fn authorize_identity(
+        &self,
+        identity: Option<p::CommandIdentity>,
+        authority: &p::ManagedAuthority,
+        runtime: &p::RuntimeBinding,
+    ) -> Result<p::CommandIdentity, BackendError> {
+        let identity =
+            identity.ok_or_else(|| BackendError::Denied("managed identity missing".into()))?;
+        if identity.gateway_id != authority.gateway_id
+            || identity.workspace_id != authority.workspace_id
+            || identity.subject_id != authority.subject_id
+            || identity.runtime.as_ref() != Some(runtime)
+        {
+            return Err(BackendError::Denied(
+                "managed request ownership mismatch".into(),
+            ));
+        }
+        Ok(identity)
+    }
+    fn get(&self, identity: &p::CommandIdentity) -> Result<p::ExecutionStatus, BackendError> {
+        let mut status = self.store.get(identity).map_err(unavailable)?;
+        if status.terminal.is_none()
+            && lock(&self.live)?
+                .get(&command_key(identity))
+                .is_some_and(|command| command.active.load(Ordering::Acquire))
+        {
+            status.state = p::ExecutionState::Running.into();
+        }
+        Ok(status)
+    }
+    fn start(
+        &self,
+        start: p::ManagedStart,
+        executor: Arc<dyn BoundaryExec>,
+        runtime: &tokio::runtime::Handle,
+    ) -> Result<p::ExecutionStatus, BackendError> {
+        let identity = start
+            .identity
+            .clone()
+            .ok_or_else(|| BackendError::Denied("managed identity missing".into()))?;
+        let mut live = lock(&self.live)?;
+        let writer = match self.store.reserve(&start).map_err(unavailable)? {
+            Admission::Existing(mut status) => {
+                if status.terminal.is_none()
+                    && live
+                        .get(&command_key(&identity))
+                        .is_some_and(|command| command.active.load(Ordering::Acquire))
+                {
+                    status.state = p::ExecutionState::Running.into();
+                }
+                return Ok(status);
+            }
+            Admission::New(writer) => writer,
+        };
+        let spec = start
+            .effective_spec
+            .ok_or_else(|| BackendError::Denied("managed spec missing".into()))?;
+        let timeout = spec
+            .execution_timeout
+            .map(|timeout| Duration::new(timeout.seconds as u64, timeout.nanos as u32));
+        let admitted_at = std::time::Instant::now();
+        let launch_limit = timeout
+            .unwrap_or(Duration::from_secs(10))
+            .min(Duration::from_secs(10));
+        let native = ExecSpec {
+            program: spec.argv[0].clone(),
+            args: spec.argv[1..].to_vec(),
+            shell: None,
+            project_tool: spec.scope == p::CommandScope::ProjectTool as i32,
+            runtime_helper: None,
+            env: spec.environment.into_iter().collect(),
+            workdir: Some(spec.workdir),
+            pty: false,
+        };
+        let session = runtime
+            .block_on(async { tokio::time::timeout(launch_limit, executor.exec(native)).await })
+            .map_err(|_| {
+                unavailable("managed launch admission timed out; closure remains unresolved")
+            })??;
+        let remaining = timeout.map(|timeout| timeout.saturating_sub(admitted_at.elapsed()));
+        let active = Arc::new(AtomicBool::new(true));
+        live.insert(
+            command_key(&identity),
+            LiveCommand {
+                process: session.process.clone(),
+                active: active.clone(),
+            },
+        );
+        runtime.spawn(run_command(
+            session,
+            spec.stdin,
+            remaining,
+            writer,
+            identity.clone(),
+            active,
+        ));
+        Ok(p::ExecutionStatus {
