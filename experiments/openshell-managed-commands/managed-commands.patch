+// SPDX-License-Identifier: Apache-2.0
+//! Operator-pinned artifact identity for the custom managed execution profile.
+//! Claims are trusted only when supplied through driver-owned bootstrap state.
+
+use serde::{Deserialize, Serialize};
+
+pub const PROFILE_CLAIM: &str = "kingdom.managed.profile";
+pub const PROFILE_DIGEST_CLAIM: &str = "kingdom.managed.profile.sha256";
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ManagedProfile {
+    pub schema_version: u32,
+    pub gateway_binary_sha256: String,
+    pub supervisor_image: String,
+    pub sandbox_runtime_image: String,
+    pub sandbox_runtime_binary_sha256: String,
+}
+
+impl ManagedProfile {
+    pub fn validate(&self) -> Result<(), String> {
+        if self.schema_version != 1
+            || !valid_digest(&self.gateway_binary_sha256)
+            || !valid_digest(&self.sandbox_runtime_binary_sha256)
+            || !pinned_image(&self.supervisor_image)
+            || !pinned_image(&self.sandbox_runtime_image)
+        {
+            return Err(
+                "managed profile requires supported schema and immutable artifact pins".into(),
+            );
+        }
+        Ok(())
+    }
+
+    pub fn canonical_json(&self) -> Result<String, String> {
+        self.validate()?;
+        serde_json::to_string(self).map_err(|error| error.to_string())
+    }
+
+    pub fn digest(&self) -> Result<String, String> {
+        digest_hex(self.canonical_json()?.as_bytes())
+    }
+
+    pub fn from_claims(json: &str, digest: &str) -> Result<Self, String> {
+        if json.len() > 8192 || !valid_digest(digest) {
+            return Err("invalid managed profile claims".into());
+        }
+        let profile: Self =
+            serde_json::from_str(json).map_err(|_| "invalid managed profile JSON")?;
+        if profile.canonical_json()? != json || profile.digest()? != digest {
+            return Err("managed profile claim digest or canonical encoding mismatch".into());
+        }
+        Ok(profile)
+    }
+
+    pub fn verify_runtime_file(&self, path: &std::path::Path) -> Result<(), String> {
+        use std::io::Read;
+        self.validate()?;
+        let mut file =
+            std::fs::File::open(path).map_err(|_| "cannot open managed runtime executable")?;
+        let mut digest = openshell_crypto::sha256_digest().map_err(|error| error.to_string())?;
+        let mut buffer = [0_u8; 131072];
+        loop {
+            let count = file
+                .read(&mut buffer)
+                .map_err(|_| "cannot read managed runtime executable")?;
+            if count == 0 {
+                break;
+            }
+            digest
+                .update(&buffer[..count])
+                .map_err(|error| error.to_string())?;
+        }
+        if hex(&digest.finish().map_err(|error| error.to_string())?)
+            != self.sandbox_runtime_binary_sha256
+        {
+            return Err("running sandbox runtime differs from managed profile".into());
+        }
+        Ok(())
+    }
+
+    pub fn verify_runtime_binary(&self, bytes: &[u8]) -> Result<(), String> {
+        self.validate()?;
+        if digest_hex(bytes)? != self.sandbox_runtime_binary_sha256 {
+            return Err("sandbox runtime binary differs from managed profile".into());
+        }
+        Ok(())
+    }
+}
+
+fn hex(bytes: &[u8]) -> String {
+    const DIGITS: &[u8; 16] = b"0123456789abcdef";
+    bytes
+        .iter()
+        .flat_map(|byte| {
+            [
+                DIGITS[(byte >> 4) as usize] as char,
+                DIGITS[(byte & 15) as usize] as char,
+            ]
+        })
+        .collect()
+}
+
+fn digest_hex(bytes: &[u8]) -> Result<String, String> {
+    openshell_crypto::sha256(bytes)
+        .map(|digest| hex(&digest))
+        .map_err(|error| error.to_string())
+}
+
+pub fn valid_digest(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+fn pinned_image(value: &str) -> bool {
+    if value.len() > 2048 {
+        return false;
+    }
+    let Some((repository, digest)) = value.split_once("@sha256:") else {
+        return false;
+    };
+    !repository.is_empty()
+        && repository
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"._:/-".contains(&b))
+        && !repository.starts_with('/')
+        && valid_digest(digest)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn profile() -> ManagedProfile {
+        ManagedProfile {
+            schema_version: 1,
+            gateway_binary_sha256: "1".repeat(64),
+            supervisor_image: format!("registry.example/supervisor@sha256:{}", "2".repeat(64)),
+            sandbox_runtime_image: format!("registry.example/runtime@sha256:{}", "3".repeat(64)),
+            sandbox_runtime_binary_sha256: digest_hex(b"runtime").unwrap(),
+        }
+    }
+
+    #[test]
+    fn managed_profile_canonical_claims_bind_every_artifact() {
+        let profile = profile();
+        let json = profile.canonical_json().unwrap();
+        let digest = profile.digest().unwrap();
+        assert_eq!(
+            ManagedProfile::from_claims(&json, &digest).unwrap(),
+            profile
+        );
+        assert!(ManagedProfile::from_claims(&format!(" {json}"), &digest).is_err());
+        let mut changed = profile.clone();
+        changed.gateway_binary_sha256 = "4".repeat(64);
+        assert!(ManagedProfile::from_claims(&changed.canonical_json().unwrap(), &digest).is_err());
+        assert!(profile.verify_runtime_binary(b"runtime").is_ok());
+        assert!(profile.verify_runtime_binary(b"different").is_err());
+    }
+
+    #[test]
+    fn managed_profile_rejects_mutable_or_ambiguous_pins() {
+        for value in [
+            "image:latest",
+            "image@sha256:123",
+            "image@sha256:ABCD",
+            "/image@sha256:abc",
+            "",
+        ] {
+            let mut profile = profile();
+            profile.supervisor_image = value.into();
+            assert!(profile.validate().is_err());
+        }
+        let mut profile = profile();
+        profile.schema_version = 2;
+        assert!(profile.validate().is_err());
+        profile.schema_version = 1;
+        profile.gateway_binary_sha256 = "F".repeat(64);
+        assert!(profile.validate().is_err());
+    }
+}
