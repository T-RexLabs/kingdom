+    async fn boundary_terminal(
+        service: &ManagedService,
+        value: &p::ExecutionStatus,
+        incomplete: bool,
+    ) -> Vec<p::OutputChunk> {
+        let identity = value.identity.clone().unwrap();
+        let chunks = vec![
+            p::OutputChunk {
+                sequence: 1,
+                stream: p::OutputStream::Stdout as i32,
+                data: b"archive".to_vec(),
+            },
+            p::OutputChunk {
+                sequence: 2,
+                stream: p::OutputStream::Stderr as i32,
+                data: b"proof".to_vec(),
+            },
+        ];
+        let mut framed = Vec::new();
+        for chunk in &chunks {
+            let bytes = chunk.encode_to_vec();
+            framed.extend_from_slice(&(bytes.len() as u32).to_be_bytes());
+            framed.extend(bytes);
+        }
+        let mut receipt = p::TerminalReceipt {
+            schema_version: 1,
+            identity: Some(identity.clone()),
+            exit_status: Some(p::terminal_receipt::ExitStatus::ExitCode(if incomplete {
+                1
+            } else {
+                0
+            })),
+            group_closed: true,
+            termination_requested: incomplete,
+            forced_cleanup: incomplete,
+            process_clean: !incomplete,
+            output: Some(p::OutputManifest {
+                last_sequence: 2,
+                total_bytes: 12,
+                sha256: openshell_crypto::sha256(&framed).unwrap().to_vec(),
+                complete: !incomplete,
+                gap: false,
+                truncated: incomplete,
+            }),
+            receipt_sha256: vec![],
+            input_complete: !incomplete,
+        };
+        receipt.receipt_sha256 = checked::receipt_digest(&receipt).unwrap();
+        let terminal = p::ExecutionStatus {
+            identity: Some(identity.clone()),
+            state: p::ExecutionState::Closed as i32,
+            terminal: Some(receipt),
+            durable_output_sequence: 2,
+        };
+        service
+            .state
+            .store
+            .put_if(
+                "FixtureBoundary",
+                &format!("fixture-status:{}", identity.boundary_request_id),
+                &format!("fixture-status:{}", identity.boundary_request_id),
+                "",
+                &terminal.encode_to_vec(),
+                None,
+                WriteCondition::Unconditional,
+            )
+            .await
+            .unwrap();
+        service
+            .state
+            .store
+            .put_if(
+                "FixtureOutput",
+                &format!("fixture-output:{}", identity.boundary_request_id),
+                &format!("fixture-output:{}", identity.boundary_request_id),
+                "",
+                &p::ManagedOutputBatch {
+                    chunks: chunks.clone(),
+                    next_sequence: 3,
+                    durable_output_sequence: 2,
+                }
+                .encode_to_vec(),
+                None,
+                WriteCondition::Unconditional,
+            )
+            .await
+            .unwrap();
+        chunks
+    }
