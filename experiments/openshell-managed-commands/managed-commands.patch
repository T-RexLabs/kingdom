+                        .ok_or_else(|| Status::not_found("boundary output unavailable"))?;
+                    let mut batch = p::ManagedOutputBatch::decode(row.payload.as_slice()).unwrap();
+                    batch
+                        .chunks
+                        .retain(|chunk| chunk.sequence > read.after_sequence);
+                    batch.chunks.truncate(read.limit as usize);
+                    batch.next_sequence = batch
+                        .chunks
+                        .last()
+                        .map_or(read.after_sequence + 1, |c| c.sequence + 1);
+                    Ok(Response::new(p::ManagedBoundaryResponse {
+                        result: Some(p::managed_boundary_response::Result::Output(batch)),
+                    }))
+                }
+                _ => Err(Status::not_found("boundary has no result")),
+            }
+        }
+    }
