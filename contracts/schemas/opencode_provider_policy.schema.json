{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingdom.local/contracts/schemas/opencode_provider_policy.schema.json",
  "title": "OpenCodeProviderPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "policy_id",
    "model_policy",
    "agent_policy",
    "timeouts",
    "retry_boundaries",
    "escalation"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v2"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fallback_enabled", "fallback_strategy"],
      "properties": {
        "fallback_enabled": {
          "type": "boolean",
          "const": false
        },
        "fallback_strategy": {
          "type": "string",
          "const": "disabled_for_mvp"
        }
      }
    },
    "agent_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_agent", "role_agents"],
      "properties": {
        "default_agent": {
          "type": "string",
          "minLength": 1
        },
        "role_agents": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strict_startup_total_timeout",
        "completion_reconcile_total_timeout",
        "completion_reconcile_backoff_schedule",
        "dispatch_ack_timeout",
        "first_event_timeout",
        "stream_inactivity_timeout",
        "cancel_grace_timeout",
        "cancel_force_timeout",
        "node_wall_clock"
      ],
      "properties": {
        "strict_startup_total_timeout": {"type": "string", "minLength": 2},
        "completion_reconcile_total_timeout": {"type": "string", "minLength": 2},
        "completion_reconcile_backoff_schedule": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 2}
        },
        "dispatch_ack_timeout": {"type": "string", "minLength": 2},
        "first_event_timeout": {"type": "string", "minLength": 2},
        "stream_inactivity_timeout": {"type": "string", "minLength": 2},
        "cancel_grace_timeout": {"type": "string", "minLength": 2},
        "cancel_force_timeout": {"type": "string", "minLength": 2},
        "node_wall_clock": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "retry_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_source",
        "provider_retry_class",
        "internal_runtime_retry_class",
        "conditional_retry_class",
        "non_retryable_class",
        "hard_fail_codes"
      ],
      "properties": {
        "policy_source": {"type": "string", "minLength": 1},
        "provider_retry_class": {"type": "string", "minLength": 1},
        "internal_runtime_retry_class": {"type": "string", "minLength": 1},
        "conditional_retry_class": {"type": "string", "minLength": 1},
        "non_retryable_class": {"type": "string", "minLength": 1},
        "hard_fail_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retry_exhausted_target_role", "unresolved_strategic_target_role", "dead_letter_required"],
      "properties": {
        "retry_exhausted_target_role": {"type": "string", "minLength": 1},
        "unresolved_strategic_target_role": {"type": "string", "minLength": 1},
        "dead_letter_required": {"type": "boolean", "const": true}
      }
    }
  }
}
