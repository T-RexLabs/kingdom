{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingdom.local/contracts/schemas/role_communication_policy.schema.json",
  "title": "RoleCommunicationPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policy_id", "default_role_template", "roles"],
  "properties": {
    "version": {
      "type": "string",
      "const": "v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "default_role_template": {
      "$ref": "#/$defs/roleTemplate"
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/roleTemplate"
      }
    }
  },
  "$defs": {
    "roleTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_prompt_template", "mailbox_template"],
      "properties": {
        "system_prompt_template": {
          "type": "string",
          "minLength": 1
        },
        "mailbox_template": {
          "$ref": "#/$defs/mailboxTemplate"
        }
      }
    },
    "mailboxTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["salutation_template", "body_template", "signoff_template", "signature_template"],
      "properties": {
        "salutation_template": {
          "type": "string",
          "minLength": 1
        },
        "body_template": {
          "type": "string",
          "minLength": 1
        },
        "signoff_template": {
          "type": "string",
          "minLength": 1
        },
        "signature_template": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
