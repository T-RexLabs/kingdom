{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingdom.local/contracts/schemas/worker_output.schema.json",
  "title": "WorkerOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "summary", "payload_json", "artifacts", "error_reason"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload_json": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "error_reason": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "error_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["failed", "blocked"]
          }
        }
      },
      "then": {
        "properties": {
          "error_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mime", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["deliverable", "verification", "orchestration_meta"]
        },
        "action": {
          "type": "string",
          "enum": ["write", "delete"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
