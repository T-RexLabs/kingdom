{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingdom.local/contracts/schemas/event_v1.schema.json",
  "title": "EventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "run_id",
    "run_event_seq",
    "attempt_id",
    "seq",
    "created_at",
    "event_type",
    "payload_json",
    "actor_id",
    "role_id",
    "authority_source",
    "reason_code",
    "reason_text",
    "correlation_id",
    "causation_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_event_seq": {
      "type": "integer",
      "minimum": 1
    },
    "node_run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "attempt.started",
        "attempt.progress",
        "attempt.failed",
        "attempt.succeeded",
        "attempt.cancelled",
        "attempt.activity",
        "attempt.retry_scheduled",
        "attempt.retry_queued",
        "attempt.rerun_queued",
		"attempt.final_rework_queued",
        "attempt.timeout_warning",
        "attempt.sequence_gap",
        "approval.recorded",
        "escalation.raised",
        "run.state_changed",
        "run.retry_reopened",
        "run.rerun_reopened",
        "node.state_changed",
        "mailbox.message_recorded"
      ]
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "role_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_source": {
      "type": "string",
      "minLength": 1
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "reason_text": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "minLength": 1
    },
    "payload_json": {
      "type": "object"
    }
  }
}
