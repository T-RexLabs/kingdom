FROM --platform=$BUILDPLATFORM golang:1.27.0-bookworm@sha256:ded31c68586d2e49e760acc2e65a884b23d032e9bbbed0ae0c55abd3fcaf4452 AS helpers
WORKDIR /src
ENV GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY contracts/ contracts/
ARG TARGETARCH
# The reviewed managed boundary and pinned OpenCode base are ARM64 artifacts.
RUN test "$TARGETARCH" = arm64
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 GOMAXPROCS=2 go build -p=2 -trimpath -o /out/kingdom-workspace-helper ./cmd/kingdom-workspace-helper && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 GOMAXPROCS=2 go build -p=2 -trimpath -o /out/kingdom-file-tool-helper ./cmd/kingdom-file-tool-helper && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 GOMAXPROCS=2 go build -p=2 -trimpath -o /out/kingdom-provider-launcher ./cmd/kingdom-provider-launcher

FROM ghcr.io/anomalyco/opencode@sha256:08481eba3f9e6dbcc4b4bee9e399cd7abe384ebee12b849f0223ff41923344e0
COPY --from=helpers --chmod=0555 /out/kingdom-workspace-helper /usr/local/libexec/kingdom-workspace-helper
COPY --from=helpers --chmod=0555 /out/kingdom-file-tool-helper /usr/local/libexec/kingdom-file-tool-helper
COPY --from=helpers --chmod=0555 /out/kingdom-provider-launcher /usr/local/libexec/kingdom-provider-launcher
COPY --chmod=0444 internal/providers/opencode/plugin/ /usr/local/lib/kingdom-plugin/
RUN chmod 0555 /usr/local/lib/kingdom-plugin && mkdir -p /workspace && chown 1000:1000 /workspace && chmod 0700 /workspace
USER 1000:1000
ENTRYPOINT []
CMD ["/bin/sleep", "86400"]
